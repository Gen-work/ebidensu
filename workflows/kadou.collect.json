{
  "schema": 1,
  "id": "kadou.collect",
  "title": "JJODWDBx 稼働確認: 9 本の転送の OPEN 側証跡を集める(B = GoAnywhere ジョブログ 全ラウンド / C = Jenkins 受信フォルダ + バッチ処理状況一覧)。見るだけ: データ配置・ジョブ実行・削除はしない",
  "version": "0.1.0",
  "profile": "jod-kadou",
  "page": "goAnywhere",

  "vars": { "capture": "capture/kadou", "jobLogDir": "log/GoAnywhere/jobs" },

  "source": {
    "table": "wl",
    "select": { "field": "collect", "pendingWhen": "!= ok" },
    "groupBy": "PROJECT",
    "orderBy": "CORREL"
  },

  "onError": { "policy": "ask", "byFailure": { "not_met": { "policy": "skip" } } },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "mustExist": false, "as": "wl" } },
    { "id": "seed", "use": "table.upsert",
      "label": "9 本の転送(profile worklist.json の targets)を作業リスト kadou.csv へ。既にある行は進み具合をそのまま",
      "with": { "worklist": "wl", "rows": "{{profile.worklist.targets}}",
                "fields": { "CORREL": "CORREL", "JOB": "JOB", "SLOT": "SLOT", "SYS": "SYS", "IFNO": "IFNO", "PROJECT": "PROJECT",
                            "RECVDIR": "RECVDIR", "SHELL": "SHELL", "SS": "SS", "BATCH": "BATCH", "EXPECT": "EXPECT",
                            "LABEL_ROW": "LABEL_ROW", "PIC_ROW": "PIC_ROW", "LOG_ROW": "LOG_ROW", "JK_ROW": "JK_ROW", "JKPIC_ROW": "JKPIC_ROW", "DATA_ROW": "DATA_ROW" },
                "overwrite": ["SLOT", "SYS", "IFNO", "PROJECT", "RECVDIR", "SHELL", "SS", "BATCH", "EXPECT", "LABEL_ROW", "PIC_ROW", "LOG_ROW", "JK_ROW", "JKPIC_ROW", "DATA_ROW"] } },
    { "id": "prepare", "use": "human.prepare",
      "with": { "message": "{{profile.vocabulary.messages.openPages}}", "url": "{{profile.paths.goAnywhereUrl}}" } },
    { "id": "ga", "use": "screen.find_window",
      "with": { "title": "{{page.windowTitle}}", "state": "maximize", "as": "ga" } },
    { "id": "jk", "use": "screen.find_window",
      "with": { "title": "{{profile.pages.jenkinsRecv.windowTitle}}", "state": "restore",
                "width": "{{profile.window.width}}", "height": "{{profile.window.height}}", "as": "jk" } },
    { "id": "bs", "use": "screen.find_window",
      "with": { "title": "{{profile.pages.batchStatus.windowTitle}}", "state": "restore",
                "width": "{{profile.window.width}}", "height": "{{profile.window.height}}", "as": "bs" } }
  ],

  "each": [
    { "id": "gaFilter", "use": "human.prepare", "once": "group",
      "label": "GoAnywhere のプロジェクト名をこの I/F にする(3 本 x 6 ラウンド = 18 行まで。表示 100 件)",
      "with": { "message": "GoAnywhere「完了したジョブ」: プロジェクト名 = {{item.PROJECT}}、日付範囲 = Today、表示 100 件にして一覧が出たら Enter(この I/F の今日のジョブログを全部ダウンロードします)" } },
    { "id": "gaText", "use": "browser.wait_for", "once": "group",
      "label": "GoAnywhere 一覧を更新して保存(この I/F の今日の行)",
      "with": { "window": "ga", "contains": "{{item.PROJECT}}", "expectPage": ["ジョブ番号"],
                "refreshRecipe": "{{page.refreshRecipe}}", "timeoutSec": "{{page.timeoutSec}}", "pollMs": "{{page.pollMs}}",
                "archiveTo": "log/GoAnywhere/{{run.mmdd}}-{{item.IFNO}}.txt" } },
    { "id": "gaRows", "use": "verify.parse_text", "once": "group",
      "with": { "text": "{{steps.gaText.out.text}}", "grammar": "{{page.grammar}}" } },
    { "id": "gaJobs", "use": "verify.filter_records", "once": "group",
      "label": "この I/F の Receive プロジェクトで、今日始まった行のジョブ番号",
      "with": { "records": "{{steps.gaRows.out.records}}", "pluck": "key",
                "where": [ { "field": "projectName", "op": "equals", "value": "{{item.PROJECT}}" },
                           { "field": "startTime", "op": "matches", "value": "^{{run.date}}" } ] } },
    { "id": "gaLogs", "use": "browser.download_each", "once": "group",
      "label": "ジョブ番号ごとにジョブログをダウンロード(もうあるものは取らない)",
      "with": { "window": "ga", "terms": "{{steps.gaJobs.out.plucked}}",
                "recipe": "{{page.jobLogRecipe}}", "glob": "*.log",
                "destDir": "{{vars.jobLogDir}}/{{run.mmdd}}", "nameTemplate": "{term}.log",
                "backKeys": "{{page.jobLogBackKeys}}" } },
    { "id": "jkIds", "use": "browser.navigate", "once": "group",
      "when": "item.SYS == IDS",
      "with": { "window": "jk", "url": "{{profile.paths.jenkinsRecvIds}}" } },
    { "id": "jkIgp", "use": "browser.navigate", "once": "group",
      "when": "item.SYS == IGP2",
      "with": { "window": "jk", "url": "{{profile.paths.jenkinsRecvIgp2}}" } },
    { "id": "bsIds", "use": "browser.navigate", "once": "group",
      "when": "item.SYS == IDS",
      "with": { "window": "bs", "url": "{{profile.paths.batchStatusIds}}" } },
    { "id": "bsIgp", "use": "browser.navigate", "once": "group",
      "when": "item.SYS == IGP2",
      "with": { "window": "bs", "url": "{{profile.paths.batchStatusIgp2}}" } },

    { "id": "jkText", "use": "browser.wait_for",
      "label": "Jenkins 受信フォルダ(F5)にこの相関IDのファイルがあるか(無ければ timeoutSec 後に found = false で先へ: C = 未取得)。一覧は保存",
      "with": { "window": "jk", "contains": "{{item.CORREL}}.", "nearAny": "{{profile.pages.jenkinsRecv.fingerprint.ok}}",
                "refreshRecipe": "{{profile.pages.jenkinsRecv.refreshRecipe}}",
                "timeoutSec": "{{profile.pages.jenkinsRecv.timeoutSec}}", "pollMs": "{{profile.pages.jenkinsRecv.pollMs}}",
                "archiveTo": "{{vars.capture}}/{{item.keySafe}}/jenkins.txt" } },
    { "id": "logs", "use": "verify.job_logs",
      "label": "B: この相関IDのジョブログ(今日の全ラウンド): uploaded / return code 0 / deleted / End。証跡には B と Jenkins が揃う一番早いラウンド",
      "with": { "paths": "{{steps.gaLogs.out.paths}}", "key": "{{item.CORREL}}",
                "recvDir": "{{item.RECVDIR}}", "shell": "{{item.SHELL}}", "ss": "{{item.SS}}",
                "day": "{{run.date}}", "preferText": "{{steps.jkText.out.text}}" } },
    { "id": "runs", "use": "table.set",
      "with": { "worklist": "wl", "field": "RUNS", "value": "{{steps.logs.out.okCount}}/{{steps.logs.out.runCount}} ok" } },
    { "id": "bSet", "use": "table.set",
      "with": { "worklist": "wl", "field": "B", "value": "{{steps.logs.out.code}}" } },

    { "id": "noRun", "use": "human.gate",
      "label": "B に使えるラウンドが無い(ジョブログが無い / 全部 ng): 理由を見て Enter = ng のまま記録して次へ",
      "when": "steps.logs.out.hasChosen == false",
      "with": { "code": "ng", "askWhen": ["ng"], "key": "{{item.key}}",
                "reason": "{{steps.logs.out.reason}}", "checklist": "{{steps.logs.out.summary}}",
                "evidence": "{{steps.gaText.out.path}}" } },
    { "id": "noRunMark", "use": "flow.checkpoint",
      "when": "steps.logs.out.hasChosen == false",
      "with": { "worklist": "wl", "field": "collect", "value": "ng" } },
    { "id": "haveRun", "use": "flow.require",
      "with": { "value": "chosen:{{steps.logs.out.hasChosen}}", "equals": "chosen:true",
                "message": "no ok run of {{item.CORREL}} today: recorded collect = ng, nothing to show on the OPEN side" } },

    { "id": "fileSet", "use": "table.set",
      "with": { "worklist": "wl", "field": "FILE", "value": "{{steps.logs.out.chosenFile}}" } },
    { "id": "jkFind", "use": "browser.find",
      "label": "Jenkins 受信フォルダで対象ファイルを Ctrl+F(オレンジのまま撮る)",
      "with": { "window": "jk", "term": "{{steps.logs.out.chosenFile}}" } },
    { "id": "jkShot", "use": "screen.capture_window",
      "with": { "window": "jk", "saveAs": "{{vars.capture}}/{{item.keySafe}}/jenkins.png", "bounds": "visible" } },
    { "id": "jkSet", "use": "table.set",
      "with": { "worklist": "wl", "field": "C_JK", "value": "{{steps.jkFind.out.hit}}" } },
    { "id": "dataIds", "use": "file.download",
      "label": "GFIXデータ用: 受信ファイルそのもの(IDS の Jenkins から)",
      "when": "item.SYS == IDS",
      "with": { "url": "{{profile.paths.jenkinsRecvIds}}/{{steps.logs.out.chosenFile}}",
                "saveAs": "DATA/GFIX/{{item.CORREL}}/{{steps.logs.out.chosenFile}}", "countLines": true } },
    { "id": "dataIgp", "use": "file.download",
      "label": "GFIXデータ用: 受信ファイルそのもの(IGP2 の Jenkins から)",
      "when": "item.SYS == IGP2",
      "with": { "url": "{{profile.paths.jenkinsRecvIgp2}}/{{steps.logs.out.chosenFile}}",
                "saveAs": "DATA/GFIX/{{item.CORREL}}/{{steps.logs.out.chosenFile}}", "countLines": true } },
    { "id": "data", "use": "file.list",
      "with": { "dir": "DATA/GFIX/{{item.CORREL}}", "glob": "{{steps.logs.out.chosenFile}}", "countLines": true, "requireFiles": true } },

    { "id": "bsAsk", "use": "human.prepare",
      "label": "バッチ処理状況一覧は人が検索する(画面の項目を工具は触らない)",
      "with": { "message": "バッチ処理状況一覧({{item.SYS}}): 相関ID = {{item.CORREL}}、処理種別 = データ取込、開始日 FROM / TO = 今日 ({{run.date}} を yyyyMMdd で)で検索。結果の行(正常終了・処理件数・バッチID {{item.BATCH}}・SS {{item.SS}})が見えたら Enter。この転送のファイル: {{steps.logs.out.chosenFile}}(開始 {{steps.logs.out.chosenStart}})、件数の参考(7/29 実績) {{item.EXPECT}} 件" } },
    { "id": "bsFront", "use": "browser.send_keys",
      "label": "バッチ処理状況一覧を前へ(Esc だけ。何も押さない)",
      "with": { "window": "bs", "sequence": "{ESC}", "waitMs": 600 } },
    { "id": "bsShot", "use": "screen.capture_window",
      "with": { "window": "bs", "saveAs": "{{vars.capture}}/{{item.keySafe}}/batch.png", "bounds": "visible" } },
    { "id": "bsText", "use": "browser.read_text",
      "with": { "window": "bs", "archiveTo": "{{vars.capture}}/{{item.keySafe}}/batch.txt" } },
    { "id": "bsJudge", "use": "verify.assert",
      "label": "C: 画面に この相関ID・正常終了・バッチID があり、異常終了が無い",
      "with": { "record": { "text": "{{steps.bsText.out.text}}" },
                "rules": { "default": "ok", "rules": [
                  { "field": "text", "op": "matches", "value": "{{item.CORREL}}", "else": "unknown", "message": "the page does not show {{item.CORREL}} (search not run, or another correl)" },
                  { "field": "text", "op": "matches", "value": "^(?![\\s\\S]*異常終了)", "else": "ng", "message": "the page shows 異常終了" },
                  { "field": "text", "op": "matches", "value": "正常終了", "else": "unknown", "message": "no 正常終了 on the page" },
                  { "field": "text", "op": "matches", "value": "{{item.BATCH}}", "else": "unknown", "message": "batch id {{item.BATCH}} is not on the page" } ] } } },
    { "id": "bsSet", "use": "table.set",
      "with": { "worklist": "wl", "field": "C_BS", "value": "{{steps.bsJudge.out.code}}" } },

    { "id": "verdict", "use": "verify.assert",
      "with": { "record": { "b": "{{steps.logs.out.code}}", "listed": "{{steps.logs.out.listed}}", "bs": "{{steps.bsJudge.out.code}}" },
                "rules": { "default": "ok", "rules": [
                  { "field": "b", "op": "equals", "value": "ok", "else": "ng", "message": "B (GoAnywhere): {{steps.logs.out.reason}}" },
                  { "field": "bs", "op": "notEquals", "value": "ng", "else": "ng", "message": "C (バッチ処理状況一覧): {{steps.bsJudge.out.reason}}" },
                  { "field": "listed", "op": "matches", "value": "(?i)^true$", "else": "unknown", "message": "C (Jenkins): {{steps.logs.out.chosenFile}} is not in the receive folder listing" },
                  { "field": "bs", "op": "equals", "value": "ok", "else": "unknown", "message": "C (バッチ処理状況一覧): {{steps.bsJudge.out.reason}}" } ] } } },
    { "id": "look", "use": "human.gate",
      "label": "1 本ずつ目で確認: Jenkins(オレンジ)とバッチ処理状況一覧の画像、B の各ラウンド",
      "with": { "code": "{{steps.verdict.out.code}}", "askWhen": ["ok", "ng", "unknown"], "key": "{{item.key}}",
                "reason": "{{item.JOB}} {{item.CORREL}}: B {{steps.logs.out.okCount}}/{{steps.logs.out.runCount}} run(s) ok; evidence file {{steps.logs.out.chosenFile}} ({{steps.logs.out.chosenStart}}); received file {{steps.data.out.total}} file(s); count reference {{item.EXPECT}}",
                "alert": "{{steps.verdict.out.reason}}",
                "checklist": "{{steps.logs.out.summary}}",
                "evidence": ["{{steps.jkShot.out.path}}", "{{steps.bsShot.out.path}}", "{{steps.logs.out.chosenPath}}"],
                "front": ["{{profile.pages.batchStatus.windowTitle}}"] } },
    { "id": "record", "use": "file.write_json",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/collect.json",
                "data": { "key": "{{item.key}}", "date": "{{run.date}}", "job": "{{item.JOB}}", "sys": "{{item.SYS}}",
                          "file": "{{steps.logs.out.chosenFile}}", "start": "{{steps.logs.out.chosenStart}}",
                          "jobLog": "{{steps.logs.out.chosenPath}}", "runs": "{{steps.logs.out.runs}}",
                          "b": "{{steps.logs.out.code}}", "listed": "{{steps.logs.out.listed}}", "batch": "{{steps.bsJudge.out.code}}",
                          "jenkinsPng": "{{steps.jkShot.out.path}}", "batchPng": "{{steps.bsShot.out.path}}",
                          "dataFiles": "{{steps.data.out.paths}}", "dataLines": "{{steps.data.out.files}}",
                          "expect": "{{item.EXPECT}}",
                          "gate": { "auto": "{{steps.verdict.out.code}}", "reason": "{{steps.verdict.out.reason}}", "answer": "{{steps.look.out.code}}", "note": "{{steps.look.out.note}}" } } } },
    { "id": "checkpoint", "use": "flow.checkpoint",
      "when": "steps.look.out.action != skip",
      "with": { "worklist": "wl", "field": "collect", "value": "{{steps.look.out.code}}" } }
  ],

  "teardown": [
    { "id": "status", "use": "progress.status",
      "with": { "worklist": "wl", "field": "collect",
                "next": ["ebi.ps1 status -Profile jod-kadou -WorkDir {{run.workDir}}   (9 行 x B / C の表)",
                         "ebi.ps1 run workflows\\kadou.evidence.json -WorkDir {{run.workDir}}   (ジョブごとの証跡ブック)"] } }
  ]
}
