{
  "schema": 1,
  "id": "gfixRecv.gift",
  "title": "GFIX受信: GIFT 側のファイルがあるか(DATA/GIFT/<J名> / <W名>)。無ければ Jenkins の一覧から GIFT 実行日時の前後で探して落とす",
  "version": "0.1.0",
  "profile": "gfix-recv",

  "vars": {
    "_doc": "10/20: track stopped on M/SJODJSPQ and QJODJSPP for a missing DATA/GIFT/<J> folder. Run after plan: a job whose folder has files is ok at once (no window needed); for the others the Jenkins data/report page (the same window track uses, found in setup) is read once per job and its files around the GIFT run (mapping.xlsx M / N via plan: GIFT_DATE / GIFT_TIME, -2..+13 min) are offered -- the expected number in the window (FileCount, else one) is taken without asking, anything else is a pick (window, then that day by hour). Files go to DATA/GIFT/<J>.",
    "capture": "capture/gfix",
    "giftBefore": 2,
    "giftAfter": 13
  },

  "source": {
    "table": "wl",
    "select": { "field": "gift", "pendingWhen": "!= ok" },
    "orderBy": "GFIX_TIME"
  },

  "onError": { "policy": "ask" },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "as": "wl" } },
    { "id": "jk", "use": "screen.find_window",
      "label": "Jenkins data/report のウィンドウ(track と同じ。開いていなければ開いて r)",
      "with": { "title": "{{profile.pages.jenkinsReport.windowTitle}}", "state": "restore",
                "width": "{{profile.window.width}}", "height": "{{profile.window.height}}", "as": "jk" } }
  ],

  "each": [
    { "id": "have", "use": "file.list",
      "label": "DATA/GIFT/<J名>(無ければ <W名>)にファイルがあるか(見るだけ)",
      "with": { "dir": "{{profile.paths.bix}}/DATA/GIFT/{{item.JOB}}", "alsoDirs": ["{{profile.paths.bix}}/DATA/GIFT/{{item.Excel_NAME}}"],
                "glob": "*.csv", "mustExist": false } },
    { "id": "haveOk", "use": "flow.checkpoint",
      "label": "もうある: gift = ok",
      "when": "steps.have.out.total != 0",
      "with": { "worklist": "wl", "field": "gift", "value": "ok" } },
    { "id": "jkText", "use": "browser.wait_for",
      "label": "Jenkins を F5、一覧の最後(フッター)まで出たら読む",
      "when": "steps.have.out.total == 0",
      "with": { "window": "jk", "contains": "{{profile.pages.jenkinsReport.endText}}",
                "deselectAt": "{{profile.pages.jenkinsReport.deselectAt}}",
                "refreshRecipe": "{{profile.pages.jenkinsReport.refreshRecipe}}",
                "timeoutSec": "{{profile.pages.jenkinsReport.timeoutSec}}", "pollMs": "{{profile.pages.jenkinsReport.pollMs}}",
                "archiveTo": "{{vars.capture}}/{{item.keySafe}}/jenkins-gift.txt",
                "expectPage": "{{profile.pages.jenkinsReport.fingerprint.ok}}" } },
    { "id": "jkRec", "use": "verify.parse_text",
      "when": "steps.have.out.total == 0",
      "with": { "text": "{{steps.jkText.out.text}}", "grammar": "{{profile.grammar.jenkinsReport}}" } },
    { "id": "cand", "use": "verify.time_candidates",
      "label": "GIFT 実行日時(mapping.xlsx M / N)の -2..+13 分にあるファイル。数が合えば確定",
      "when": "steps.have.out.total == 0",
      "with": { "records": "{{steps.jkRec.out.records}}", "date": "{{item.GIFT_DATE}}", "clock": "{{item.GIFT_TIME}}",
                "beforeMinutes": "{{vars.giftBefore}}", "afterMinutes": "{{vars.giftAfter}}",
                "namePattern": "{{profile.pages.jenkinsReport.fileNamePattern}}",
                "expectFallback": "{{item.FileCount}}", "label": "GIFT run" } },
    { "id": "pick", "use": "human.pick",
      "label": "確定なら聞かずにそれ。そうでなければ選ぶ(Enter = 時刻の窓、番号 = その時間帯、名前の一部でも)",
      "when": "steps.have.out.total == 0",
      "with": { "title": "GIFT files: {{item.JOB}}", "sets": "{{steps.cand.out.sets}}", "presets": "{{steps.cand.out.presets}}",
                "info": "{{steps.cand.out.info}}", "noun": "file", "autoPick": "{{steps.cand.out.certain}}" } },
    { "id": "dl", "use": "file.download",
      "label": "選んだファイルを DATA/GIFT/<J名> へ",
      "when": "steps.pick.out.any == true",
      "with": { "baseUrl": "{{profile.paths.jenkinsReportUrl}}", "names": "{{steps.pick.out.picked}}",
                "dir": "{{profile.paths.bix}}/DATA/GIFT/{{item.JOB}}", "countLines": true, "maxFiles": 10 } },
    { "id": "dlOk", "use": "flow.checkpoint",
      "label": "落とした: gift = ok",
      "when": "steps.dl.out.total exists",
      "with": { "worklist": "wl", "field": "gift", "value": "ok" } },
    { "id": "event", "use": "progress.event",
      "with": { "action": "gift", "message": "{{steps.cand.out.reason}}" } }
  ],

  "teardown": [
    { "id": "status", "use": "progress.status",
      "with": { "worklist": "wl", "field": "gift",
                "next": ["ebi.ps1 run workflows\\gfixRecv.track.json -WorkDir {{run.workDir}}   (HOST のジョブごと)"] } }
  ]
}
