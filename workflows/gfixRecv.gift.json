{
  "schema": 1,
  "id": "gfixRecv.gift",
  "title": "GFIX受信: GIFT 側のファイルがあるか(DATA/GIFT/<J名> / <W名>)。無ければ Jenkins の一覧から GIFT 実行日時の前後で探して落とす",
  "version": "0.2.1",
  "profile": "gfix-recv",

  "vars": {
    "_doc": "10/20: track stopped on M/SJODJSPQ and QJODJSPP for a missing DATA/GIFT/<J> folder. Run after plan: a job whose folder has files is ok at once (no window needed); for the others the Jenkins data/report page (the same window track uses, found in setup) is read once per job and its files around the GIFT run (mapping.xlsx M / N via plan: GIFT_DATE / GIFT_TIME, -2..+13 min) are offered -- the expected number in the window (FileCount, else one) is taken without asking, anything else is a pick (window, then that day by hour). Files go to DATA/GIFT/<J>. 10/26: a folder that already has files is no longer ok just for that -- K/LJODWAF1 held another run's files (L's two were 7 hours apart). The files are checked against the GIFT run (verify.file_window: FileCount, the files within haveSpread minutes of each other, the day in the name, the file time inside -haveBefore..+haveAfter); anything off stops at a gate: o = right after all, n = set them aside (capture/gfix/<W>/set-aside-gift) and take them from Jenkins, r = put right by hand, look again. Downloads keep the server time (serverTime) so a later check can read it.",
    "capture": "capture/gfix",
    "giftBefore": 2,
    "giftAfter": 13,
    "haveBefore": 2,
    "haveAfter": 60,
    "haveSpread": 15
  },

  "source": {
    "table": "wl",
    "select": { "field": "gift", "pendingWhen": "!= ok" },
    "orderBy": "GFIX_TIME"
  },

  "onError": { "policy": "ask" },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "as": "wl" } },
    { "id": "jk", "use": "screen.find_window",
      "label": "Jenkins data/report のウィンドウ(track と同じ。開いていなければ開いて r)",
      "with": { "title": "{{profile.pages.jenkinsReport.windowTitle}}", "state": "restore",
                "width": "{{profile.window.width}}", "height": "{{profile.window.height}}", "as": "jk" } }
  ],

  "each": [
    { "id": "have", "use": "file.list",
      "label": "DATA/GIFT/<J名>(無ければ <W名>)にファイルがあるか(見るだけ)",
      "with": { "dir": "{{profile.paths.bix}}/DATA/GIFT/{{item.JOB}}", "alsoDirs": ["{{profile.paths.bix}}/DATA/GIFT/{{item.Excel_NAME}}"],
                "glob": "*.csv", "mustExist": false } },
    { "id": "haveChk", "use": "verify.file_window",
      "label": "もうあるファイルは GIFT 実行のものか: 数(FileCount)・同じ回(互いに haveSpread 分以内)・名前の日付・ファイル時刻(-haveBefore..+haveAfter 分)",
      "when": "steps.have.out.total != 0",
      "with": { "files": "{{steps.have.out.files}}", "date": "{{item.GIFT_DATE}}", "clock": "{{item.GIFT_TIME}}",
                "beforeMinutes": "{{vars.haveBefore}}", "afterMinutes": "{{vars.haveAfter}}", "spreadMinutes": "{{vars.haveSpread}}",
                "expectFallback": "{{item.FileCount}}", "label": "GIFT run" } },
    { "id": "haveGate", "use": "human.gate",
      "label": "合わなければ止まる: o = やはり正しい / n = 脇へ置いて Jenkins から取る / r = 手で入れ替えた、見直す",
      "when": "steps.have.out.total != 0",
      "with": { "code": "{{steps.haveChk.out.code}}", "askWhen": ["ng"], "reason": "{{steps.haveChk.out.reason}}",
                "alert": "{{steps.haveChk.out.problems}}", "evidence": "{{steps.haveChk.out.lines}}",
                "checklist": ["o = these are the GIFT run's files after all",
                              "n = wrong files: move them to {{vars.capture}}/{{item.keySafe}}/set-aside-gift and pick from the Jenkins list",
                              "r = you put the right files in by hand: list and check again"],
                "enterOk": false, "recheck": true } },
    { "id": "haveAside", "use": "file.set_aside",
      "label": "n: いまのファイルを DATA/GIFT から capture の set-aside-gift へ(track が別の回のファイルで比べないように)",
      "when": "steps.haveGate.out.action == ng",
      "with": { "paths": "{{steps.have.out.paths}}", "toDir": "{{vars.capture}}/{{item.keySafe}}/set-aside-gift" } },
    { "id": "haveRedo", "use": "flow.redo",
      "label": "n -> 空になったフォルダから(Jenkins で探す) / r -> 一覧から見直し",
      "with": { "action": "{{steps.haveGate.out.action}}", "map": { "ng": "have", "recheck": "have" } } },
    { "id": "haveOk", "use": "flow.checkpoint",
      "label": "もうあって GIFT 実行のもの: gift = ok",
      "when": "steps.haveGate.out.code == ok",
      "with": { "worklist": "wl", "field": "gift", "value": "ok" } },
    { "id": "jkText", "use": "browser.wait_for",
      "label": "Jenkins を F5、一覧の最後(フッター)まで出たら読む",
      "when": "steps.have.out.total == 0",
      "with": { "window": "jk", "contains": "{{profile.pages.jenkinsReport.endText}}",
                "deselectAt": "{{profile.pages.jenkinsReport.deselectAt}}",
                "refreshRecipe": "{{profile.pages.jenkinsReport.refreshRecipe}}",
                "timeoutSec": "{{profile.pages.jenkinsReport.timeoutSec}}", "pollMs": "{{profile.pages.jenkinsReport.pollMs}}",
                "archiveTo": "{{vars.capture}}/{{item.keySafe}}/jenkins-gift.txt",
                "expectPage": "{{profile.pages.jenkinsReport.fingerprint.ok}}" } },
    { "id": "jkRec", "use": "verify.parse_text",
      "when": "steps.have.out.total == 0",
      "with": { "text": "{{steps.jkText.out.text}}", "grammar": "{{profile.grammar.jenkinsReport}}" } },
    { "id": "cand", "use": "verify.time_candidates", "retryFrom": "jkText",
      "label": "GIFT 実行日時(mapping.xlsx M / N)の -2..+13 分にあるファイル。数が合えば確定",
      "when": "steps.have.out.total == 0",
      "with": { "records": "{{steps.jkRec.out.records}}", "date": "{{item.GIFT_DATE}}", "clock": "{{item.GIFT_TIME}}",
                "beforeMinutes": "{{vars.giftBefore}}", "afterMinutes": "{{vars.giftAfter}}",
                "namePattern": "{{profile.pages.jenkinsReport.fileNamePattern}}",
                "expectFallback": "{{item.FileCount}}", "label": "GIFT run" } },
    { "id": "pick", "use": "human.pick",
      "label": "確定なら聞かずにそれ。そうでなければ選ぶ(Enter = 時刻の窓、番号 = その時間帯、名前の一部でも)",
      "when": "steps.have.out.total == 0",
      "with": { "title": "GIFT files: {{item.JOB}}", "sets": "{{steps.cand.out.sets}}", "presets": "{{steps.cand.out.presets}}",
                "info": "{{steps.cand.out.info}}", "noun": "file", "autoPick": "{{steps.cand.out.certain}}" } },
    { "id": "dl", "use": "file.download", "retryFrom": "jkText",
      "label": "選んだファイルを DATA/GIFT/<J名> へ",
      "when": "steps.pick.out.any == true",
      "with": { "baseUrl": "{{profile.paths.jenkinsReportUrl}}", "names": "{{steps.pick.out.picked}}",
                "dir": "{{profile.paths.bix}}/DATA/GIFT/{{item.JOB}}", "countLines": true, "maxFiles": 10,
                "serverTime": true } },
    { "id": "dlOk", "use": "flow.checkpoint",
      "label": "落とした: gift = ok",
      "when": "steps.dl.out.total exists",
      "with": { "worklist": "wl", "field": "gift", "value": "ok" } },
    { "id": "event", "use": "progress.event",
      "with": { "action": "gift", "message": "{{steps.cand.out.reason}}" } }
  ],

  "teardown": [
    { "id": "status", "use": "progress.status",
      "with": { "worklist": "wl", "field": "gift",
                "next": ["ebi.ps1 run workflows\\gfixRecv.track.json -WorkDir {{run.workDir}}   (HOST のジョブごと)"] } }
  ]
}
