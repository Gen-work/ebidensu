{
  "schema": 1,
  "id": "gfixRecv.evidence",
  "title": "GFIX受信: 証跡ブック(GFIX受信結果 / GIFTデータvsGFIXデータ)を作る",
  "version": "0.8.0",
  "profile": "gfix-recv",
  "page": "jenkinsReport",

  "vars": { "capture": "capture/gfix" },

  "source": {
    "table": "wl",
    "select": { "field": "evidence", "pendingWhen": "!= ok" },
    "groupBy": "Excel_NAME",
    "orderBy": "GFIX_TIME"
  },

  "onError": { "policy": "ask", "byFailure": { "not_met": { "policy": "skip" },
                                               "write_failed": { "policy": "retry", "times": 4, "backoffMs": 1500 },
                                               "save_failed": { "policy": "retry", "times": 3, "backoffMs": 2000 } } },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "as": "wl" } },
    { "id": "app", "use": "excel.ensure_app", "with": { "visible": true, "as": "xl" } },
    { "id": "prepare", "use": "human.prepare",
      "with": { "message": "Jenkins の data/report を開いてください(証跡のスクリーンショット用)", "url": "{{profile.paths.jenkinsReportUrl}}" } },
    { "id": "jk", "use": "screen.find_window",
      "with": { "title": "{{page.windowTitle}}", "state": "restore",
                "width": "{{profile.window.width}}", "height": "{{profile.window.height}}", "as": "jk" } },
    { "id": "list", "use": "excel.open",
      "label": "GFIX一覧(1 枚目の Excel スナップの元。読み取り専用: フィルターをかけて撮るだけ、保存しない)",
      "with": { "app": "xl", "path": "{{profile.paths.gfixList}}", "readOnly": true, "as": "list" } }
  ],

  "each": [
    { "id": "track", "use": "file.read_json",
      "label": "track の結果(無ければ track を待ちに戻してこの行を飛ばす)",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/track.json" } },
    { "id": "trackLost", "use": "table.set",
      "label": "track.json が無いのに track = ok: track を待ち(空)に戻す(次の gfixRecv.track がこの行を拾う)",
      "when": "steps.track.out.exists == false",
      "with": { "worklist": "wl", "field": "track", "value": "pending" } },
    { "id": "trackHere", "use": "flow.require",
      "when": "steps.track.out.exists == false",
      "with": { "value": "missing", "equals": "present",
                "message": "track.json is not there although track was ok: track is set back to pending -- run gfixRecv.track -Only {{item.key}}, then this flow again" } },
    { "id": "trackOk", "use": "flow.require",
      "label": "track が ng(OPEN 側で異常終了)の行には証跡を作らない: この行を飛ばす",
      "with": { "value": "{{steps.track.out.data.verdict}}", "equals": "ok",
                "message": "the track judged this job ng (failed on the OPEN side): no evidence to build" } },
    { "id": "logs", "use": "file.read_json",
      "label": "logs の結果(無ければ logs を待ちに戻してこの行を飛ばす)",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/logs.json" } },
    { "id": "logsLost", "use": "table.set",
      "label": "logs.json が無いのに logs = ok: logs を待ち(空)に戻す(次の gfixRecv.logs がこの行を拾う)",
      "when": "steps.logs.out.exists == false",
      "with": { "worklist": "wl", "field": "logs", "value": "pending" } },
    { "id": "logsHere", "use": "flow.require",
      "when": "steps.logs.out.exists == false",
      "with": { "value": "missing", "equals": "present",
                "message": "logs.json is not there although logs was ok: logs is set back to pending -- run gfixRecv.logs -Only {{item.key}}, then this flow again" } },

    { "id": "book", "use": "file.find",
      "with": { "dir": "{{profile.paths.bix}}", "glob": "{{profile.layout.evidence.glob}}", "expect": "one" } },
    { "id": "bookFree", "use": "file.wait_unlocked", "once": "group",
      "label": "証跡ブックが空くまで待つ(10/20: 前の本を閉じた直後や、誰かが開いていると読み取り専用になった)",
      "with": { "path": "{{steps.book.out.path}}", "everySec": 10, "timeoutMin": 10 } },
    { "id": "open", "use": "excel.open", "once": "group",
      "with": { "app": "xl", "path": "{{steps.book.out.path}}", "as": "wb" } },

    { "id": "listSnap", "use": "excel.snap_list",
      "label": "GFIX一覧を 送信ジョブ = J名 でフィルターして撮る(ExcelSnap と同じ)。from～送信ジョブ が同じ行が複数あれば 元ファイル(SNDFILE) まで(加瀬さん 10/13 レビュー)",
      "with": { "workbook": "list", "sheet": "{{profile.layout.evidence.list.sheet}}", "value": "{{item.JOB}}",
                "groupRow": "{{profile.layout.evidence.list.groupRow}}", "subRow": "{{profile.layout.evidence.list.subRow}}",
                "left": "{{profile.layout.evidence.list.left}}", "job": "{{profile.layout.evidence.list.job}}",
                "extendTo": "{{profile.layout.evidence.list.extendTo}}",
                "savePng": "{{vars.capture}}/{{item.keySafe}}/pic1.png" } },
    { "id": "excelSnap", "use": "excel.place_picture",
      "label": "その PNG を GFIX受信結果 B3 へ(B3 に前の図があれば差し替え)",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.gfixResult}}", "path": "{{steps.listSnap.out.png}}",
                "cell": "B3", "replace": "atCell" } },
    { "id": "giftSnap", "use": "excel.place_picture",
      "label": "SNDFILE まで撮ったときは GIFT受信結果 の 1 枚目も差し替え",
      "when": "steps.listSnap.out.extended == true",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.giftResult}}", "path": "{{steps.listSnap.out.png}}",
                "cell": "B3", "replace": "first" } },
    { "id": "gfixPic1", "use": "excel.export_pictures",
      "label": "GFIX受信結果 の 1 枚目(今貼った図)を PNG に",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.gfixResult}}", "only": 1, "saveDir": "{{vars.capture}}/{{item.keySafe}}/pic1gfix" } },
    { "id": "giftPic1", "use": "excel.export_pictures",
      "label": "GIFT受信結果 の 1 枚目を PNG に",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.giftResult}}", "only": 1, "saveDir": "{{vars.capture}}/{{item.keySafe}}/pic1gift" } },
    { "id": "pic1Cmp", "use": "screen.compare_strip",
      "label": "1 枚目のジョブ列を GIFT 側の 1 枚目と画素で比べる(違えば GATE で赤字。止まらない。OCR はやめた: 10/21)",
      "with": { "a": "{{steps.gfixPic1.out.paths}}", "b": "{{steps.giftPic1.out.paths}}",
                "fromFrac": "{{steps.listSnap.out.jobFrom}}", "toFrac": "{{steps.listSnap.out.jobTo}}", "bodyFrom": "{{steps.listSnap.out.bodyFrom}}",
                "label": "picture 1 job column (GFIX vs GIFT)", "saveBase": "{{vars.capture}}/{{item.keySafe}}/pic1cmp" } },

    { "id": "jobLog", "use": "excel.write_lines",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.gfixResult}}",
                "row": "{{steps.excelSnap.out.nextRow}}",
        "minRow": "{{profile.layout.evidence.logMinRow}}", "label": "{{profile.layout.evidence.labels.jobLog}}", "labelBold": true,
                "paths": "{{steps.logs.out.data.jobLogs}}",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "jobMark", "use": "excel.highlight",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.gfixResult}}",
                "fromRow": "{{steps.jobLog.out.firstRow}}", "toRow": "{{steps.jobLog.out.lastRow}}",
                "patterns": "{{profile.layout.evidence.highlight.jobLog}}",
                "unitsPerColumn": "{{profile.layout.evidence.highlight.unitsPerColumn}}" } },

    { "id": "blocks", "use": "file.extract_blocks",
      "label": "GFIXReceive.log / Unzip.log から転送ファイルの START..END",
      "with": { "paths": "{{steps.logs.out.data.receiveLogs}}", "blockKeys": "{{steps.logs.out.data.transferFiles}}",
                "encoding": "cp932", "markers": "{{profile.layout.evidence.highlight.receiveLog}}",
                "saveTo": "{{vars.capture}}/{{item.keySafe}}/receive.txt",
                "sourceLabels": "{{profile.layout.evidence.labels.receiveLogBySource}}", "defaultLabel": "{{profile.layout.evidence.labels.receiveLog}}" } },
    { "id": "recvLog", "use": "excel.write_lines",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.gfixResult}}",
                "row": "{{steps.jobLog.out.nextRow}}", "gapRows": 1,
                "label": "{{steps.blocks.out.label}}", "labelBold": true,
                "paths": ["{{steps.blocks.out.path}}"], "encoding": "utf8",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "recvMark", "use": "excel.highlight",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.gfixResult}}",
                "fromRow": "{{steps.recvLog.out.firstRow}}", "toRow": "{{steps.recvLog.out.lastRow}}",
                "patterns": "{{profile.layout.evidence.highlight.receiveLog}}",
                "unitsPerColumn": "{{profile.layout.evidence.highlight.unitsPerColumn}}" } },

    { "id": "jkF5", "use": "browser.send_keys",
      "label": "Jenkins を F5(1 回だけ。読み込みを途中で止めない)",
      "with": { "window": "jk", "sequence": "{F5}", "waitMs": 2500 } },
    { "id": "jkText", "use": "browser.wait_for",
      "label": "一覧の最下部(全てのファイルをzipで)まで読み込まれたら、テキストを保存",
      "with": { "window": "jk", "contains": "{{page.endText}}", "deselectAt": "{{page.deselectAt}}",
                "refreshRecipe": ["keys:^{END}", "wait:800"], "timeoutSec": "{{page.timeoutSec}}", "pollMs": "{{page.pollMs}}",
                "archiveTo": "{{vars.capture}}/{{item.keySafe}}/jenkins-evidence.txt" } },
    { "id": "jkEnd", "use": "browser.send_keys",
      "label": "読み込み完了後にもう一度最下部へ(スクリーンショットの位置を一覧の末尾に合わせる)",
      "with": { "window": "jk", "sequence": "^{END}", "waitMs": 800 } },
    { "id": "jkShot", "use": "screen.capture_window", "front": "jk",
      "with": { "window": "jk", "saveAs": "{{vars.capture}}/{{item.keySafe}}/jenkins.png", "bounds": "visible" } },
    { "id": "jkRec", "use": "verify.parse_text",
      "with": { "text": "{{steps.jkText.out.text}}", "grammar": "{{page.grammar}}" } },
    { "id": "jkInk", "use": "screen.find_ink_rows",
      "label": "ファイル名列の青いリンク文字の行",
      "with": { "path": "{{steps.jkShot.out.path}}", "x": "{{page.mark.stripX}}", "width": "{{page.mark.stripWidth}}",
                "ink": "blue", "minHeight": 6 } },
    { "id": "jkRects", "use": "screen.list_rects",
      "with": { "names": "{{steps.jkRec.out.names}}", "targets": "{{steps.track.out.data.jenkinsFiles}}",
                "bands": "{{steps.jkInk.out.bands}}", "x": "{{page.mark.x}}", "width": "{{page.mark.width}}",
                "height": "{{page.mark.height}}", "lastRowCenterY": "{{page.mark.lastRowCenterY}}", "rowPitch": "{{page.mark.rowPitch}}" } },
    { "id": "jkPic", "use": "excel.insert_pictures",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.gfixResult}}",
                "row": "{{steps.recvLog.out.nextRow}}", "skipRows": 1,
                "pictures": ["{{steps.jkShot.out.path}}"], "rects": "{{steps.jkRects.out.rects}}", "tag": "jenkins", "replace": true } },

    { "id": "ifName", "use": "excel.write_cell",
      "label": "GIFTデータvsGFIXデータ B3 = 送信データ!A3",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.compare}}", "cell": "B3",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "fromCell": "A3",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "stepName", "use": "excel.write_cell",
      "label": "GIFTデータvsGFIXデータ G3 = 送信データ!B3(STEP 名。加瀬さん 10/13 レビュー)。ファイルが 2 組以上の job: B3 が空なら warning(手で書く)",
      "when": "steps.track.out.data.pairs.1 exists",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.compare}}", "cell": "{{profile.layout.evidence.stepName.cell}}",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "fromCell": "{{profile.layout.evidence.stepName.fromCell}}", "trim": true, "keepIfEmpty": true,
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "stepNameOne", "use": "excel.write_cell",
      "label": "同上、ファイル 1 組の job: STEP 名がないのが普通(10/21 Q/RJODWDBC)-- B3 が空なら G3 はそのまま、warning なし",
      "when": "steps.track.out.data.pairs.1 empty",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.compare}}", "cell": "{{profile.layout.evidence.stepName.cell}}",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "fromCell": "{{profile.layout.evidence.stepName.fromCell}}", "trim": true, "keepIfEmpty": true, "warnIfEmpty": false,
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "hostPics", "use": "excel.export_pictures",
      "label": "送信データの HOST 図を PNG に(行番号を読むため。シートは変えない)",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.sendData}}", "saveDir": "{{vars.capture}}/{{item.keySafe}}/host" } },
    { "id": "hostLines", "use": "screen.read_line_numbers",
      "label": "各 HOST 図の左端の行番号(最初 / 最後)を OCR",
      "with": { "paths": "{{steps.hostPics.out.paths}}" } },
    { "id": "dfRanges", "use": "verify.df_ranges",
      "label": "DF 図の行数を HOST 図に合わせる(DF 行 = HOST 行 - 1。HOST の最後 - 1 がファイルの行数と違う = 空行が落ちた: 合わせない)",
      "with": { "pairs": "{{steps.track.out.data.pairs}}", "ranges": "{{steps.hostLines.out.ranges}}" } },
    { "id": "dfShots", "use": "screen.launch_capture",
      "label": "DF をその行数で撮り直す(track の図がすでに同じ行数なら撮らない)",
      "with": { "exe": "{{profile.paths.dfExe}}", "argSets": "{{steps.track.out.data.pairs}}",
                "plans": "{{steps.dfRanges.out.plans}}", "reuse": "{{steps.track.out.data.dfShots}}",
                "width": "{{profile.layout.df.width}}", "height": "{{profile.layout.df.height}}", "heightEnd": "{{profile.layout.df.heightEnd}}",
                "settleMs": "{{profile.layout.df.settleMs}}", "screenLines": "{{profile.layout.df.screenLines}}", "linesEnd": "{{profile.layout.df.linesEnd}}",
                "keysMid": "{{profile.layout.df.keysMid}}", "keysSecond": "{{profile.layout.df.keysEnd}}",
                "windowTitle": "{{profile.layout.df.windowTitle}}", "fitStrip": "{{profile.layout.df.marks.0.lastInk}}",
                "saveDir": "{{vars.capture}}/{{item.keySafe}}/df", "closeOthers": true } },
    { "id": "dfPlan", "use": "excel.stack_plan",
      "with": { "sets": "{{steps.dfShots.out.shots}}",
                "separator": "{{run.toolDir}}/{{profile.layout.df.separator}}",
                "separatorColumn": "{{profile.layout.df.separatorColumn}}", "separatorRows": "{{profile.layout.df.separatorRows}}",
                "markRects": "{{profile.layout.df.marks}}" } },
    { "id": "dfPics", "use": "excel.insert_pictures",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.compare}}",
                "row": "{{profile.layout.evidence.compareFirstRow}}", "pictures": "{{steps.dfPlan.out.pictures}}", "tag": "df", "replace": true } },
    { "id": "setLabels", "use": "excel.label_sections",
      "label": "ファイルが 2 組以上: 2 組目からの DF 図の上の行にも 送信データ の同じ組のラベル(B = 相関 ID、G = STEP 名)。10/23 FJODWAF1 B66 / G66",
      "when": "steps.track.out.data.pairs.1 exists",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.compare}}", "shapes": "{{steps.dfPics.out.shapes}}",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "keyColumn": "{{profile.layout.evidence.stepName.sectionKeyColumn}}",
                "fromFirstRow": "{{profile.layout.evidence.stepName.sectionFirstRow}}", "cells": "{{profile.layout.evidence.stepName.sectionCells}}", "startAt": 2,
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },

    { "id": "tidy", "use": "excel.tidy",
      "with": { "workbook": "wb", "fontSheets": ["{{profile.layout.evidence.sheets.gfixResult}}"], "dismissDialogs": "{{profile.layout.evidence.saveDialogs}}", "cell": "{{profile.layout.evidence.homeCell}}", "cellFor": "{{profile.layout.evidence.homeCellFor}}",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },

    { "id": "look", "use": "human.gate",
      "label": "ブックを目で確認(Enter = OK / n = NG / s = あとで)。自動チェックの食い違いは赤字",
      "with": { "code": "unknown", "askWhen": ["unknown"],
                "reason": "{{steps.pic1Cmp.out.reason}}",
                "checklist": "{{profile.layout.evidence.checklist}}",
                "alert": ["{{steps.pic1Cmp.out.alert}}", "{{steps.excelSnap.out.note}}", "{{steps.dfRanges.out.alert}}"],
                "evidence": ["{{steps.book.out.path}}", "{{steps.listSnap.out.png}}", "{{steps.jkShot.out.path}}"] } },
    { "id": "lookLog", "use": "file.write_json",
      "label": "自動チェックと人の答えを並べて残す(あとでルールに育てる材料: docs/ebi-dance/KNOWLEDGE.md)",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/gate.json",
                "data": { "key": "{{item.key}}", "date": "{{item.GFIX_DATE}}",
                          "auto": { "pic1Cmp": "{{steps.pic1Cmp.out.code}}", "pic1Score": "{{steps.pic1Cmp.out.score}}", "reason": "{{steps.pic1Cmp.out.reason}}",
                                    "dfRanges": "{{steps.dfRanges.out.reason}}", "hostLines": "{{steps.hostLines.out.ranges}}", "dfShots": "{{steps.dfShots.out.shots}}",
                                    "groups": "{{steps.excelSnap.out.groups}}" },
                          "person": { "action": "{{steps.look.out.action}}", "note": "{{steps.look.out.note}}" } } } },

    { "id": "checkpoint", "use": "flow.checkpoint",
      "when": "steps.look.out.action != skip",
      "with": { "worklist": "wl", "field": "evidence", "value": "{{steps.look.out.code}}" } },

    { "id": "close", "use": "excel.close", "once": "groupEnd",
      "with": { "workbook": "wb", "save": false } }
  ],

  "teardown": [
    { "id": "listClose", "use": "excel.close", "with": { "workbook": "list" } },
    { "id": "quit", "use": "excel.quit_app", "with": { "app": "xl" } },
    { "id": "status", "use": "progress.status", "with": { "worklist": "wl", "field": "evidence", "next": ["ebi.ps1 run workflows\\gfixRecv.deliver.json -WorkDir {{run.workDir}}   (レビュー依頼: チェックシート 1 行 + メール下書き)"] } }
  ]
}
