{
  "schema": 1,
  "id": "gfixRecv.track",
  "title": "GFIX受信: HOST のジョブ終了ごとに GoAnywhere / Jenkins / DF を確認して Teams に返す",
  "version": "0.4.0",
  "profile": "gfix-recv",
  "page": "goAnywhere",
  "vars": {
    "capture": "capture/gfix"
  },
  "source": {
    "table": "wl",
    "select": {
      "field": "track",
      "pendingWhen": "!= ok"
    },
    "orderBy": "GFIX_TIME"
  },
  "onError": {
    "policy": "ask",
    "byFailure": {
      "operator_skip": {
        "policy": "skip"
      }
    }
  },
  "setup": [
    {
      "id": "load",
      "use": "table.load",
      "with": {
        "path": "{{profile.worklist.file}}",
        "as": "wl"
      }
    },
    {
      "id": "prepare",
      "use": "human.prepare",
      "with": {
        "message": "{{profile.vocabulary.messages.openPages}}",
        "url": "{{profile.paths.goAnywhereUrl}}"
      }
    },
    {
      "id": "ga",
      "use": "screen.find_window",
      "with": {
        "title": "{{page.windowTitle}}",
        "state": "maximize",
        "as": "ga"
      }
    },
    {
      "id": "jk",
      "use": "screen.find_window",
      "with": {
        "title": "{{profile.pages.jenkinsReport.windowTitle}}",
        "state": "restore",
        "width": "{{profile.window.width}}",
        "height": "{{profile.window.height}}",
        "as": "jk"
      }
    }
  ],
  "each": [
    {
      "id": "start",
      "use": "human.paste",
      "label": "開始時刻: 作業リストの GFIX_TIME(あれば Enter でそれ) / Teams の「実施します」をコピーして今 / 時刻を打つ",
      "with": {
        "message": "{{item.Excel_NAME}}: {{profile.vocabulary.messages.startPaste}}",
        "pattern": "{{profile.vocabulary.startPattern}}",
        "expect": "{{item.Excel_NAME}}",
        "expectGroup": "job",
        "defaultClock": "{{item.GFIX_TIME}}",
        "messageWithTime": "{{item.Excel_NAME}} 開始 {{item.GFIX_TIME}}: {{profile.vocabulary.messages.startConfirm}}"
      }
    },
    {
      "id": "saveTime",
      "use": "table.set",
      "when": "steps.start.out.source != worklist",
      "label": "決まった開始時刻を作業リスト (gfixrecv.csv) の GFIX_TIME に書く: やり直しはそのまま Enter",
      "with": {
        "worklist": "wl",
        "field": "GFIX_TIME",
        "value": "{{steps.start.out.clock}}"
      }
    },
    {
      "id": "waitHost",
      "use": "human.prepare",
      "label": "Teams の「正常終了しました」を待つ",
      "with": {
        "message": "{{item.Excel_NAME}} (開始 {{steps.start.out.clock}}): {{profile.vocabulary.messages.waitHost}}"
      }
    },
    {
      "id": "win",
      "use": "verify.time_window",
      "with": {
        "date": "{{item.GFIX_DATE}}",
        "clock": "{{steps.start.out.clock}}",
        "beforeMinutes": "{{page.windowBefore}}",
        "afterMinutes": "{{page.windowAfter}}"
      },
      "label": "開始時刻 -2..+13 分(GoAnywhere の行をこの時間帯で拾う)"
    },
    {
      "id": "gaText",
      "use": "browser.wait_for",
      "label": "更新ボタンで GoAnywhere を更新し、予定時刻 -2..+13 分の行が出るまで待つ",
      "with": {
        "window": "ga",
        "containsAny": "{{steps.win.out.minuteTexts}}",
        "refreshRecipe": "{{page.refreshRecipe}}",
        "timeoutSec": "{{page.timeoutSec}}",
        "pollMs": "{{page.pollMs}}",
        "archiveTo": "{{vars.capture}}/{{item.keySafe}}/goanywhere.txt",
        "deselectRecipe": "{{page.deselectRecipe}}",
        "expectPage": "{{page.fingerprint.ok}}",
        "settledAfter": "{{steps.win.out.window.to}}"
      }
    },
    {
      "id": "gaRec",
      "use": "verify.parse_text",
      "with": {
        "text": "{{steps.gaText.out.text}}",
        "grammar": "{{page.grammar}}"
      }
    },
    {
      "id": "mine",
      "use": "verify.filter_records",
      "label": "このジョブの行(Send + Receive)",
      "with": {
        "records": "{{steps.gaRec.out.records}}",
        "where": [
          {
            "field": "startTime",
            "op": "within",
            "value": "{{steps.win.out.window}}"
          }
        ]
      }
    },
    {
      "id": "recv",
      "use": "verify.filter_records",
      "label": "Receive の行 = GFIX に着いたファイル",
      "with": {
        "records": "{{steps.mine.out.records}}",
        "where": [
          {
            "field": "folder",
            "op": "equals",
            "value": "{{page.receiveFolder}}"
          }
        ],
        "pluck": "key",
        "spanFrom": "startTime",
        "spanTo": "endTime",
        "padBeforeSec": 2,
        "padAfterSec": 10,
        "expect": "{{item.FileCount}}"
      }
    },
    {
      "id": "gaRegion",
      "use": "screen.row_region",
      "with": {
        "window": "ga",
        "insetX": "{{page.crop.insetX}}",
        "insetY": "{{page.crop.insetY}}",
        "left": "{{page.crop.left}}",
        "right": "{{page.crop.right}}",
        "top": "{{page.crop.top}}",
        "firstRowTop": "{{page.crop.firstRowTop}}",
        "rowHeight": "{{page.crop.rowHeight}}",
        "first": "{{steps.mine.out.first}}",
        "rows": "{{steps.mine.out.matched}}"
      }
    },
    {
      "id": "gaShot",
      "use": "screen.capture_region",
      "with": {
        "x": "{{steps.gaRegion.out.x}}",
        "y": "{{steps.gaRegion.out.y}}",
        "width": "{{steps.gaRegion.out.width}}",
        "height": "{{steps.gaRegion.out.height}}",
        "saveAs": "{{vars.capture}}/{{item.keySafe}}/goanywhere.png"
      }
    },
    {
      "id": "jkDay",
      "use": "verify.time_window",
      "label": "Jenkins の一覧に出る日付の形 (yyyy/MM/dd)",
      "with": {
        "date": "{{item.GFIX_DATE}}",
        "clock": "{{steps.start.out.clock}}",
        "format": "yyyy/MM/dd"
      }
    },
    {
      "id": "jkText",
      "use": "browser.wait_for",
      "label": "Jenkins を F5、その日のファイルが見えるまで",
      "with": {
        "window": "jk",
        "contains": "{{steps.jkDay.out.atText}}",
        "deselectAt": "{{profile.pages.jenkinsReport.deselectAt}}",
        "refreshRecipe": "{{profile.pages.jenkinsReport.refreshRecipe}}",
        "timeoutSec": "{{profile.pages.jenkinsReport.timeoutSec}}",
        "pollMs": "{{profile.pages.jenkinsReport.pollMs}}",
        "archiveTo": "{{vars.capture}}/{{item.keySafe}}/jenkins.txt",
        "expectPage": "{{profile.pages.jenkinsReport.fingerprint.ok}}"
      }
    },
    {
      "id": "jkRec",
      "use": "verify.parse_text",
      "with": {
        "text": "{{steps.jkText.out.text}}",
        "grammar": "{{profile.grammar.jenkinsReport}}"
      }
    },
    {
      "id": "jkMine",
      "use": "verify.filter_records",
      "label": "Receive の時間帯に report に置かれたファイル",
      "with": {
        "records": "{{steps.jkRec.out.records}}",
        "where": [
          {
            "field": "time",
            "op": "within",
            "value": "{{steps.recv.out.span}}"
          },
          {
            "field": "key",
            "op": "matches",
            "value": "{{profile.pages.jenkinsReport.fileNamePattern}}"
          }
        ],
        "pluck": "key",
        "expect": "{{item.FileCount}}"
      }
    },
    {
      "id": "dl",
      "use": "file.download",
      "with": {
        "baseUrl": "{{profile.paths.jenkinsReportUrl}}",
        "names": "{{steps.jkMine.out.plucked}}",
        "dir": "{{profile.paths.bix}}/DATA/GFIX/{{item.Excel_NAME}}",
        "countLines": true
      }
    },
    {
      "id": "giftNames",
      "use": "verify.derive_fields",
      "label": "GIFT 側のフォルダ名の候補: J名そのまま / 5文字目を M にした名前",
      "with": {
        "records": [
          {
            "job": "{{item.JOB}}"
          }
        ],
        "set": [
          {
            "to": "m",
            "from": "job",
            "pattern": "^(.{4}).",
            "replace": "${1}M"
          }
        ]
      }
    },
    {
      "id": "gift",
      "use": "file.list",
      "with": {
        "dir": "{{profile.paths.bix}}/DATA/GIFT/{{item.JOB}}",
        "glob": "*.csv",
        "countLines": true,
        "alsoDirs": [
          "{{profile.paths.bix}}/DATA/GIFT/{{steps.giftNames.out.records.0.m}}"
        ]
      },
      "label": "GIFT 側のファイル: DATA/GIFT/<J名>、無ければ <5文字目 M>。どちらも無ければ止まって聞く"
    },
    {
      "id": "pair",
      "use": "verify.pair_files",
      "with": {
        "left": "{{steps.gift.out.files}}",
        "right": "{{steps.dl.out.files}}",
        "longOver": "{{profile.layout.df.screenLines}}"
      }
    },
    {
      "id": "pairGate",
      "use": "human.gate",
      "with": {
        "code": "{{steps.pair.out.code}}",
        "askWhen": [
          "unknown"
        ],
        "reason": "{{steps.pair.out.reason}}",
        "evidence": [
          "{{steps.gift.out.paths}}",
          "{{steps.dl.out.paths}}"
        ]
      }
    },
    {
      "id": "cmp",
      "use": "file.compare",
      "with": {
        "pairs": "{{steps.pair.out.pairs}}"
      }
    },
    {
      "id": "df",
      "use": "screen.launch_capture",
      "with": {
        "exe": "{{profile.paths.dfExe}}",
        "argSets": "{{steps.pair.out.pairs}}",
        "width": "{{profile.layout.df.width}}",
        "height": "{{profile.layout.df.height}}",
        "settleMs": "{{profile.layout.df.settleMs}}",
        "windowTitle": "{{profile.layout.df.windowTitle}}",
        "saveDir": "{{vars.capture}}/{{item.keySafe}}/df"
      }
    },
    {
      "id": "gate",
      "use": "human.gate",
      "with": {
        "code": "{{steps.cmp.out.code}}",
        "askWhen": [
          "ng",
          "unknown"
        ],
        "reason": "{{steps.cmp.out.reason}}",
        "evidence": [
          "{{steps.gaShot.out.path}}",
          "{{steps.df.out.paths}}"
        ]
      }
    },
    {
      "id": "meta",
      "use": "file.write_json",
      "with": {
        "path": "{{vars.capture}}/{{item.keySafe}}/track.json",
        "data": {
          "key": "{{item.key}}",
          "date": "{{item.GFIX_DATE}}",
          "mmdd": "{{run.mmdd}}",
          "start": "{{steps.start.out.clock}}",
          "startSource": "{{steps.start.out.source}}",
          "startMessage": "{{steps.start.out.text}}",
          "sendCount": "{{steps.start.out.fields.count}}",
          "window": "{{steps.win.out.window}}",
          "goAnywhereRows": "{{steps.mine.out.records}}",
          "recvJobs": "{{steps.recv.out.plucked}}",
          "span": "{{steps.recv.out.span}}",
          "jenkinsFiles": "{{steps.jkMine.out.plucked}}",
          "gfixFiles": "{{steps.dl.out.paths}}",
          "pairs": "{{steps.pair.out.pairs}}",
          "compare": "{{steps.cmp.out.results}}",
          "dfShots": "{{steps.df.out.shots}}",
          "goAnywhereShot": "{{steps.gaShot.out.path}}",
          "verdict": "{{steps.gate.out.code}}"
        }
      }
    },
    {
      "id": "share",
      "use": "human.share",
      "when": "steps.gate.out.code == ok",
      "with": {
        "lines": [
          "{{profile.vocabulary.messages.feedbackOk}}"
        ],
        "images": [
          "{{steps.gaShot.out.path}}",
          "{{steps.df.out.paths}}"
        ],
        "mode": "{{profile.layout.share.mode}}",
        "where": "{{profile.layout.share.where}}",
        "maxWidth": "{{profile.layout.share.maxWidth}}"
      }
    },
    {
      "id": "checkpoint",
      "use": "flow.checkpoint",
      "when": "steps.gate.out.action != skip",
      "with": {
        "worklist": "wl",
        "field": "track",
        "value": "{{steps.gate.out.code}}"
      }
    },
    {
      "id": "event",
      "use": "progress.event",
      "with": {
        "action": "tracked",
        "status": "ok",
        "message": "{{steps.gate.out.code}} {{steps.cmp.out.reason}} / teams: {{steps.share.out.action}}"
      }
    }
  ],
  "teardown": [
    {
      "id": "status",
      "use": "progress.status",
      "with": {
        "worklist": "wl",
        "field": "track"
      }
    }
  ]
}
