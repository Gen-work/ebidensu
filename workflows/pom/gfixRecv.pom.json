{
  "schema": 1,
  "id": "gfixRecv.pom",
  "title": "GFIX受信 POM 再実行: 証跡ブックの (変更後) / 変更前後比較 / HOSTvsOPEN だけを作る",
  "version": "0.1.0",
  "profile": "gfix-recv",
  "page": "jenkinsReport",
  "_doc": "10/28 POM rerun (a job that failed on its first run, was fixed and runs again). gfixRecv.evidence for a POM book: run it in a SEPARATE work folder (its own gfixrecv.csv), after plan / track / logs there. Writes only GFIX受信結果(変更後) (emptied first: it starts as a copy of the first run), GFIXデータ_変更前後比較 (GIFT data vs the rerun's GFIX data, DF) and -- only when the data differ -- GFIXデータ_HOSTvsOPEN (the HOST download vs the file OPEN received). GIFT sheets, (変更前) sheets and GIFTデータvsGFIXデータ are never touched. Kept in workflows/pom/ so the day menu (ebi status / menu) does not list it next to gfixRecv.evidence. gfixRecv.deliver does not look in the POM folder: ask for the review by hand.",

  "vars": { "capture": "capture/gfix" },

  "source": {
    "table": "wl",
    "select": { "field": "evidence", "pendingWhen": "!= ok" },
    "groupBy": "Excel_NAME",
    "orderBy": "GFIX_TIME"
  },

  "onError": { "policy": "ask", "byFailure": { "not_met": { "policy": "skip" },
                                               "write_failed": { "policy": "retry", "times": 4, "backoffMs": 1500 },
                                               "save_failed": { "policy": "retry", "times": 3, "backoffMs": 2000 } } },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "as": "wl" } },
    { "id": "app", "use": "excel.ensure_app", "with": { "visible": true, "as": "xl" } },
    { "id": "prepare", "use": "human.prepare",
      "with": { "message": "Jenkins の data/report を開いてください(証跡のスクリーンショット用)", "url": "{{profile.paths.jenkinsReportUrl}}" } },
    { "id": "jk", "use": "screen.find_window",
      "with": { "title": "{{page.windowTitle}}", "state": "restore",
                "width": "{{profile.window.width}}", "height": "{{profile.window.height}}", "as": "jk" } },
    { "id": "list", "use": "excel.open",
      "label": "GFIX一覧(1 枚目の Excel スナップの元。読み取り専用: フィルターをかけて撮るだけ、保存しない)",
      "with": { "app": "xl", "path": "{{profile.paths.gfixList}}", "readOnly": true, "as": "list" } }
  ],

  "each": [
    { "id": "track", "use": "file.read_json",
      "label": "track の結果(無ければ track を待ちに戻してこの行を飛ばす)",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/track.json" } },
    { "id": "trackLost", "use": "table.set",
      "when": "steps.track.out.exists == false",
      "with": { "worklist": "wl", "field": "track", "value": "pending" } },
    { "id": "trackHere", "use": "flow.require",
      "when": "steps.track.out.exists == false",
      "with": { "value": "missing", "equals": "present",
                "message": "track.json is not there although track was ok: track is set back to pending -- run gfixRecv.track -Only {{item.key}}, then this flow again" } },
    { "id": "trackOk", "use": "flow.require",
      "label": "track が ng の行には証跡を作らない。GIFT と GFIX のデータが違うのは POM ではありうる: track の GATE で o と答えていれば ok",
      "with": { "value": "{{steps.track.out.data.verdict}}", "equals": "ok",
                "message": "the track judged this job ng: no evidence to build (data that differ on a POM rerun: answer o at the track gate)" } },
    { "id": "logs", "use": "file.read_json",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/logs.json" } },
    { "id": "logsLost", "use": "table.set",
      "when": "steps.logs.out.exists == false",
      "with": { "worklist": "wl", "field": "logs", "value": "pending" } },
    { "id": "logsHere", "use": "flow.require",
      "when": "steps.logs.out.exists == false",
      "with": { "value": "missing", "equals": "present",
                "message": "logs.json is not there although logs was ok: logs is set back to pending -- run gfixRecv.logs -Only {{item.key}}, then this flow again" } },

    { "id": "book", "use": "file.find",
      "label": "POM ブック: <bix>/他対応/J4*_<W名>_POM*.xlsx(Convert-PomBook.ps1 で (変更前)/(変更後) にしたもの)",
      "with": { "dir": "{{profile.paths.bix}}/{{profile.layout.pom.subdir}}", "glob": "{{profile.layout.pom.glob}}", "expect": "one" } },
    { "id": "bookFree", "use": "file.wait_unlocked", "once": "group",
      "with": { "path": "{{steps.book.out.path}}", "everySec": 10, "timeoutMin": 10 } },
    { "id": "open", "use": "excel.open", "once": "group",
      "with": { "app": "xl", "path": "{{steps.book.out.path}}", "as": "wb" } },
    { "id": "afterSheet", "use": "excel.prepare_sheet", "once": "group",
      "label": "GFIX受信結果(変更後) を空にする(1 回目の内容のコピーなので、図・枠・ログ・黄色を消す。A1 のシート名の式だけ残す)",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}", "keepCells": ["A1"] } },
    { "id": "compareSheet", "use": "excel.prepare_sheet", "once": "group",
      "label": "GFIXデータ_変更前後比較 を空にする(無ければ GIFTデータvsGFIXデータ の見た目で作る)。A1 / B3 は残す",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.compare}}", "template": "{{profile.layout.evidence.sheets.compare}}",
                "keepCells": ["A1", "B3"] } },

    { "id": "listSnap", "use": "excel.snap_list",
      "label": "GFIX一覧を 送信ジョブ = J名 でフィルターして撮る(gfixRecv.evidence と同じ)",
      "with": { "workbook": "list", "sheet": "{{profile.layout.evidence.list.sheet}}", "value": "{{item.JOB}}",
                "groupRow": "{{profile.layout.evidence.list.groupRow}}", "subRow": "{{profile.layout.evidence.list.subRow}}",
                "left": "{{profile.layout.evidence.list.left}}", "job": "{{profile.layout.evidence.list.job}}",
                "extendTo": "{{profile.layout.evidence.list.extendTo}}",
                "savePng": "{{vars.capture}}/{{item.keySafe}}/pic1.png" } },
    { "id": "excelSnap", "use": "excel.place_picture",
      "label": "その PNG を GFIX受信結果(変更後) B3 へ。GIFT受信結果 には貼らない",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}", "path": "{{steps.listSnap.out.png}}",
                "cell": "B3", "replace": "atCell" } },

    { "id": "jobText", "use": "file.read_text",
      "when": "steps.track.out.data.pairs.1 exists",
      "with": { "paths": "{{steps.logs.out.data.jobLogs}}" } },
    { "id": "jobBytes", "use": "verify.parse_text",
      "when": "steps.track.out.data.pairs.1 exists",
      "with": { "text": "{{steps.jobText.out.text}}", "grammar": "{{profile.layout.evidence.jobLogUpload}}" } },
    { "id": "hostPics", "use": "excel.export_pictures",
      "label": "送信データの HOST 図を PNG に(DF の行数を合わせるため。シートは変えない)",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.evidence.sheets.sendData}}", "saveDir": "{{vars.capture}}/{{item.keySafe}}/host", "firstPerRow": true } },
    { "id": "hostLines", "use": "screen.read_line_numbers",
      "with": { "paths": "{{steps.hostPics.out.paths}}" } },
    { "id": "dfRanges", "use": "verify.df_ranges",
      "with": { "pairs": "{{steps.track.out.data.pairs}}", "ranges": "{{steps.hostLines.out.ranges}}", "shots": "{{steps.track.out.data.dfShots}}",
                "jobLogs": "{{steps.logs.out.data.jobLogs}}", "jobLogBytes": "{{steps.jobBytes.out.names}}" } },

    { "id": "jobLog", "use": "excel.write_lines",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}",
                "row": "{{steps.excelSnap.out.nextRow}}",
                "minRow": "{{profile.layout.evidence.logMinRow}}", "label": "{{profile.layout.evidence.labels.jobLog}}", "labelBold": true,
                "paths": "{{steps.dfRanges.out.jobLogs}}",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "jobMark", "use": "excel.highlight",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}",
                "fromRow": "{{steps.jobLog.out.firstRow}}", "toRow": "{{steps.jobLog.out.lastRow}}",
                "patterns": "{{profile.layout.evidence.highlight.jobLog}}",
                "unitsPerColumn": "{{profile.layout.evidence.highlight.unitsPerColumn}}" } },

    { "id": "blocks", "use": "file.extract_blocks",
      "with": { "paths": "{{steps.logs.out.data.receiveLogs}}", "blockKeys": "{{steps.logs.out.data.transferFiles}}",
                "encoding": "cp932", "markers": "{{profile.layout.evidence.highlight.receiveLog}}",
                "saveTo": "{{vars.capture}}/{{item.keySafe}}/receive.txt",
                "sourceLabels": "{{profile.layout.evidence.labels.receiveLogBySource}}", "defaultLabel": "{{profile.layout.evidence.labels.receiveLog}}" } },
    { "id": "recvLog", "use": "excel.write_lines",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}",
                "row": "{{steps.jobLog.out.nextRow}}", "gapRows": 1,
                "label": "{{steps.blocks.out.label}}", "labelBold": true,
                "paths": ["{{steps.blocks.out.path}}"], "encoding": "utf8",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "recvMark", "use": "excel.highlight",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}",
                "fromRow": "{{steps.recvLog.out.firstRow}}", "toRow": "{{steps.recvLog.out.lastRow}}",
                "patterns": "{{profile.layout.evidence.highlight.receiveLog}}",
                "unitsPerColumn": "{{profile.layout.evidence.highlight.unitsPerColumn}}" } },

    { "id": "jkF5", "use": "browser.send_keys",
      "with": { "window": "jk", "sequence": "{F5}", "waitMs": 2500 } },
    { "id": "jkText", "use": "browser.wait_for",
      "with": { "window": "jk", "contains": "{{page.endText}}", "deselectAt": "{{page.deselectAt}}",
                "refreshRecipe": ["keys:^{END}", "wait:800"], "timeoutSec": "{{page.timeoutSec}}", "pollMs": "{{page.pollMs}}",
                "archiveTo": "{{vars.capture}}/{{item.keySafe}}/jenkins-evidence.txt" } },
    { "id": "jkEnd", "use": "browser.send_keys",
      "with": { "window": "jk", "sequence": "^{END}", "waitMs": 800 } },
    { "id": "jkShot", "use": "screen.capture_window", "front": "jk",
      "with": { "window": "jk", "saveAs": "{{vars.capture}}/{{item.keySafe}}/jenkins.png", "bounds": "visible" } },
    { "id": "jkRec", "use": "verify.parse_text",
      "with": { "text": "{{steps.jkText.out.text}}", "grammar": "{{page.grammar}}" } },
    { "id": "jkInk", "use": "screen.find_ink_rows",
      "with": { "path": "{{steps.jkShot.out.path}}", "x": "{{page.mark.stripX}}", "width": "{{page.mark.stripWidth}}",
                "ink": "blue", "minHeight": 6 } },
    { "id": "jkRects", "use": "screen.list_rects",
      "retryFrom": "jkF5",
      "with": { "names": "{{steps.jkRec.out.names}}", "targets": "{{steps.track.out.data.jenkinsFiles}}",
                "bands": "{{steps.jkInk.out.bands}}", "x": "{{page.mark.x}}", "width": "{{page.mark.width}}",
                "height": "{{page.mark.height}}", "lastRowCenterY": "{{page.mark.lastRowCenterY}}", "rowPitch": "{{page.mark.rowPitch}}",
                "allowAbove": true } },
    { "id": "jkPic", "use": "excel.insert_pictures",
      "when": "steps.jkRects.out.above != true",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}",
                "row": "{{steps.recvLog.out.nextRow}}", "skipRows": 1,
                "pictures": ["{{steps.jkShot.out.path}}"], "rects": "{{steps.jkRects.out.rects}}", "tag": "jenkins", "replace": true } },
    { "id": "jkFind", "use": "browser.find",
      "when": "steps.jkRects.out.above == true",
      "with": { "window": "jk", "term": "{{steps.jkRects.out.anchor}}", "readPage": false, "waitMs": 1500 } },
    { "id": "jkShot2", "use": "screen.capture_window", "front": "jk",
      "when": "steps.jkRects.out.above == true",
      "with": { "window": "jk", "saveAs": "{{vars.capture}}/{{item.keySafe}}/jenkins.png", "bounds": "visible" } },
    { "id": "jkFindEsc", "use": "browser.send_keys",
      "when": "steps.jkRects.out.above == true",
      "with": { "window": "jk", "sequence": "{ESC}", "waitMs": 300, "copyAfter": true } },
    { "id": "jkInk2", "use": "screen.find_ink_rows",
      "when": "steps.jkRects.out.above == true",
      "with": { "path": "{{steps.jkShot2.out.path}}", "x": "{{page.mark.stripX}}", "width": "{{page.mark.stripWidth}}",
                "ink": "blue", "minHeight": 6 } },
    { "id": "jkHit", "use": "screen.find_ink_rows",
      "when": "steps.jkRects.out.above == true",
      "with": { "path": "{{steps.jkShot2.out.path}}", "x": "{{page.mark.stripX}}", "width": "{{page.mark.stripWidth}}",
                "ink": "orange", "minHeight": 6 } },
    { "id": "jkOther", "use": "screen.find_ink_rows",
      "when": "steps.jkRects.out.above == true",
      "with": { "path": "{{steps.jkShot2.out.path}}", "x": "{{page.mark.stripX}}", "width": "{{page.mark.stripWidth}}",
                "ink": "yellow", "minHeight": 6 } },
    { "id": "jkRects2", "use": "screen.list_rects",
      "when": "steps.jkRects.out.above == true",
      "retryFrom": "jkFind",
      "with": { "names": "{{steps.jkRec.out.names}}", "targets": "{{steps.track.out.data.jenkinsFiles}}",
                "bands": "{{steps.jkInk2.out.bands}}", "anchorName": "{{steps.jkRects.out.anchor}}", "anchorBands": "{{steps.jkHit.out.bands}}",
                "otherHits": "{{steps.jkOther.out.bands}}", "hitText": "{{steps.jkFindEsc.out.copied}}",
                "x": "{{page.mark.x}}", "width": "{{page.mark.width}}", "height": "{{page.mark.height}}", "rowPitch": "{{page.mark.rowPitch}}" } },
    { "id": "jkPic2", "use": "excel.insert_pictures",
      "when": "steps.jkRects.out.above == true",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.gfixResult}}",
                "row": "{{steps.recvLog.out.nextRow}}", "skipRows": 1,
                "pictures": ["{{steps.jkShot2.out.path}}"], "rects": "{{steps.jkRects2.out.rects}}", "tag": "jenkins", "replace": true } },

    { "id": "ifName", "use": "excel.write_cell",
      "label": "GFIXデータ_変更前後比較 B3 = 送信データ!A3",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.compare}}", "cell": "B3",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "fromCell": "A3",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "stepName", "use": "excel.write_cell",
      "when": "steps.track.out.data.pairs.1 exists",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.compare}}", "cell": "{{profile.layout.evidence.stepName.cell}}",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "fromCell": "{{profile.layout.evidence.stepName.fromCell}}", "trim": true, "keepIfEmpty": true,
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "stepNameOne", "use": "excel.write_cell",
      "when": "steps.track.out.data.pairs.1 empty",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.compare}}", "cell": "{{profile.layout.evidence.stepName.cell}}",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "fromCell": "{{profile.layout.evidence.stepName.fromCell}}", "trim": true, "keepIfEmpty": true, "warnIfEmpty": false,
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "dfShots", "use": "screen.launch_capture",
      "label": "DF: GIFT のデータ vs 再実行で届いた GFIX のデータ(track と同じ組)",
      "with": { "exe": "{{profile.paths.dfExe}}", "argSets": "{{steps.dfRanges.out.pairs}}",
                "plans": "{{steps.dfRanges.out.plans}}", "reuse": "{{steps.dfRanges.out.shots}}",
                "width": "{{profile.layout.df.width}}", "height": "{{profile.layout.df.height}}", "heightEnd": "{{profile.layout.df.heightEnd}}",
                "settleMs": "{{profile.layout.df.settleMs}}", "screenLines": "{{profile.layout.df.screenLines}}", "linesEnd": "{{profile.layout.df.linesEnd}}",
                "keysMid": "{{profile.layout.df.keysMid}}", "keysSecond": "{{profile.layout.df.keysEnd}}",
                "windowTitle": "{{profile.layout.df.windowTitle}}", "fitStrip": "{{profile.layout.df.marks.0.lastInk}}",
                "saveDir": "{{vars.capture}}/{{item.keySafe}}/df", "closeOthers": true } },
    { "id": "dfPlan", "use": "excel.stack_plan",
      "with": { "sets": "{{steps.dfShots.out.shots}}",
                "separator": "{{run.toolDir}}/{{profile.layout.df.separator}}",
                "separatorColumn": "{{profile.layout.df.separatorColumn}}", "separatorRows": "{{profile.layout.df.separatorRows}}",
                "markRects": "{{profile.layout.df.marks}}", "gapRows": 2 } },
    { "id": "dfPics", "use": "excel.insert_pictures",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.compare}}",
                "row": "{{profile.layout.evidence.compareFirstRow}}", "pictures": "{{steps.dfPlan.out.pictures}}", "tag": "df", "replace": true } },
    { "id": "setLabels", "use": "excel.label_sections",
      "when": "steps.track.out.data.pairs.1 exists",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.compare}}", "shapes": "{{steps.dfPics.out.shapes}}",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "keyColumn": "{{profile.layout.evidence.stepName.sectionKeyColumn}}",
                "fromFirstRow": "{{profile.layout.evidence.stepName.sectionFirstRow}}", "cells": "{{profile.layout.evidence.stepName.sectionCells}}", "startAt": 2,
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },

    { "id": "hvoCmp", "use": "file.compare",
      "label": "GIFT のデータと再実行の GFIX のデータが同じか(track の組をもう一度比べる)。違えば HOSTvsOPEN を作る",
      "with": { "pairs": "{{steps.track.out.data.pairs}}" } },
    { "id": "hvoAsk", "use": "human.gate",
      "label": "違うときだけ: HOST のデータセットをダウンロード(HOST コード 939)して DATA\\GFIX\\<W名>\\ に <データセット名>.HOST で置いてから Enter / s = この job は HOSTvsOPEN を作らない",
      "when": "steps.hvoCmp.out.code == ng",
      "with": { "code": "unknown", "askWhen": ["unknown"],
                "reason": "GIFT data and the rerun's GFIX data differ ({{steps.hvoCmp.out.reason}}) -- put the HOST download of the data set (code 939) in {{profile.paths.bix}}/DATA/GFIX/{{item.Excel_NAME}} as <data set>.HOST, then Enter: GFIXデータ_HOSTvsOPEN is made from it. s = no HOSTvsOPEN for this job",
                "evidence": ["{{steps.dfShots.out.paths}}"] } },
    { "id": "hvoHost", "use": "file.list",
      "label": "その .HOST ファイル(無ければ止まる: 置いてから r)",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "dir": "{{profile.paths.bix}}/DATA/GFIX/{{item.Excel_NAME}}", "glob": "{{profile.layout.pom.hostGlob}}",
                "countLines": true, "requireFiles": true, "expect": 1 } },
    { "id": "hvoOpen", "use": "file.list",
      "label": "OPEN で受信したファイル = track の 1 組目の GFIX 側",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "dir": "{{profile.paths.bix}}/DATA/GFIX/{{item.Excel_NAME}}", "glob": "{{steps.track.out.data.pairs.0.rightName}}",
                "countLines": true, "requireFiles": true } },
    { "id": "hvoPair", "use": "verify.pair_files",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "left": "{{steps.hvoHost.out.files}}", "right": "{{steps.hvoOpen.out.files}}", "longOver": "{{profile.layout.df.screenLines}}" } },
    { "id": "hvoDf", "use": "screen.launch_capture",
      "label": "DF: HOST のダウンロード vs OPEN で受信したファイル",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "exe": "{{profile.paths.dfExe}}", "argSets": "{{steps.hvoPair.out.pairs}}",
                "width": "{{profile.layout.df.width}}", "height": "{{profile.layout.df.height}}", "heightEnd": "{{profile.layout.df.heightEnd}}",
                "linesEnd": "{{profile.layout.df.linesEnd}}", "fitStrip": "{{profile.layout.df.marks.0.lastInk}}",
                "settleMs": "{{profile.layout.df.settleMs}}", "screenLines": "{{profile.layout.df.screenLines}}",
                "keysMid": "{{profile.layout.df.keysMid}}", "keysSecond": "{{profile.layout.df.keysEnd}}",
                "windowTitle": "{{profile.layout.df.windowTitle}}",
                "saveDir": "{{vars.capture}}/{{item.keySafe}}/hostvsopen", "closeOthers": true } },
    { "id": "hvoPlan", "use": "excel.stack_plan",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "sets": "{{steps.hvoDf.out.shots}}",
                "separator": "{{run.toolDir}}/{{profile.layout.df.separator}}",
                "separatorColumn": "{{profile.layout.df.separatorColumn}}", "separatorRows": "{{profile.layout.df.separatorRows}}",
                "markRects": "{{profile.layout.df.marks}}", "gapRows": 2 } },
    { "id": "hvoSheet", "use": "excel.prepare_sheet",
      "label": "GFIXデータ_HOSTvsOPEN: 無ければ 変更前後比較 の見た目で、そのすぐ右に作る(あれば空にする)",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.hostVsOpen}}", "template": "{{profile.layout.pom.sheets.compare}}",
                "after": "{{profile.layout.pom.sheets.compare}}", "keepCells": ["A1"] } },
    { "id": "hvoB3", "use": "excel.write_cell",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.hostVsOpen}}", "cell": "B3",
                "fromSheet": "{{profile.layout.evidence.sheets.sendData}}", "fromCell": "A3",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },
    { "id": "hvoPics", "use": "excel.insert_pictures",
      "when": "steps.hvoAsk.out.action == ok",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.pom.sheets.hostVsOpen}}",
                "row": "{{profile.layout.evidence.compareFirstRow}}", "pictures": "{{steps.hvoPlan.out.pictures}}", "tag": "df", "replace": true } },

    { "id": "tidy", "use": "excel.tidy",
      "with": { "workbook": "wb", "fontSheets": ["{{profile.layout.pom.sheets.gfixResult}}"], "dismissDialogs": "{{profile.layout.evidence.saveDialogs}}", "cell": "{{profile.layout.evidence.homeCell}}", "cellFor": "{{profile.layout.evidence.homeCellFor}}",
                "fontName": "{{profile.layout.evidence.font.name}}", "fontSize": "{{profile.layout.evidence.font.size}}" } },

    { "id": "look", "use": "human.gate",
      "label": "ブックを目で確認(Enter = OK / n = NG / s = あとで)。HOSTvsOPEN のメモ(吹き出し)は手で書く",
      "with": { "code": "unknown", "askWhen": ["unknown"],
                "reason": "POM rerun book -- GIFT vs GFIX data: {{steps.hvoCmp.out.code}} ({{steps.hvoCmp.out.reason}})",
                "checklist": "{{profile.layout.pom.checklist}}",
                "alert": ["{{steps.excelSnap.out.note}}", "{{steps.dfRanges.out.alert}}"],
                "evidence": ["{{steps.book.out.path}}", "{{steps.listSnap.out.png}}", "{{steps.jkShot.out.path}}", "{{steps.hvoDf.out.paths}}"] } },
    { "id": "lookLog", "use": "file.write_json",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/gate.json",
                "data": { "key": "{{item.key}}", "date": "{{item.GFIX_DATE}}", "pom": true,
                          "auto": { "compare": "{{steps.hvoCmp.out.code}}", "compareReason": "{{steps.hvoCmp.out.reason}}",
                                    "hostVsOpen": "{{steps.hvoAsk.out.action}}", "hostVsOpenShots": "{{steps.hvoDf.out.shots}}",
                                    "dfRanges": "{{steps.dfRanges.out.reason}}", "hostLines": "{{steps.hostLines.out.ranges}}", "dfShots": "{{steps.dfShots.out.shots}}",
                                    "afterCleared": "{{steps.afterSheet.out.shapesRemoved}}", "groups": "{{steps.excelSnap.out.groups}}" },
                          "person": { "action": "{{steps.look.out.action}}", "note": "{{steps.look.out.note}}" } } } },

    { "id": "checkpoint", "use": "flow.checkpoint",
      "when": "steps.look.out.action != skip",
      "with": { "worklist": "wl", "field": "evidence", "value": "{{steps.look.out.code}}" } },

    { "id": "close", "use": "excel.close", "once": "groupEnd",
      "with": { "workbook": "wb", "save": false } }
  ],

  "teardown": [
    { "id": "listClose", "use": "excel.close", "with": { "workbook": "list" } },
    { "id": "quit", "use": "excel.quit_app", "with": { "app": "xl" } },
    { "id": "status", "use": "progress.status", "with": { "worklist": "wl", "field": "evidence", "next": ["レビュー依頼は手で(gfixRecv.deliver は 他対応 の POM ブックを探さない)"] } }
  ]
}
