{
  "schema": 1,
  "id": "gfixRecv.pomPlan",
  "title": "GFIX受信 POM 再実行: -Only の job を作業リストに入れる(WBS から、選ぶ画面なし)",
  "version": "0.1.0",
  "profile": "gfix-recv",
  "_doc": "10/28 POM rerun, step 1 in the POM work folder. gfixRecv.plan would not offer these jobs: their WBS row already has an actual start (AJ) from the first run and this work folder's list has never seen them, so plan counts them as done outside the tool (table.day_sets). This flow takes the names given with -Only, finds their WBS rows (受信 / 修正後実施, the same columns as plan) and writes them into gfixrecv.csv with WORKDAY = GFIX_DATE = today -- a row whose GFIX_DATE changes gets track / logs / evidence / deliver cleared, as in plan. A name with no WBS row is reported and left out. Then: gfixRecv.track, gfixRecv.logs, pom/gfixRecv.pom.",

  "vars": { "wbsSheet": "WBS", "wbsFirstRow": 7, "side": "受信", "task": "修正後実施" },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "mustExist": false, "as": "wl" } },
    { "id": "named", "use": "flow.require",
      "label": "-Only が無ければ止まる(この flow は名前で入れるだけ)",
      "when": "run.only empty",
      "with": { "value": "none", "equals": "given",
                "message": "give the POM jobs with -Only, e.g. -Only CJDSWM39,CJDSWM40" } },
    { "id": "app", "use": "excel.ensure_app", "with": { "visible": false, "as": "xl" } },
    { "id": "wbs", "use": "excel.open",
      "with": { "app": "xl", "path": "{{profile.paths.wbs}}", "readOnly": true, "as": "wbs" } },
    { "id": "rows", "use": "excel.read_rows",
      "label": "WBS: 受信 / 修正後実施 の行(gfixRecv.plan と同じ列)",
      "with": { "workbook": "wbs", "sheet": "{{vars.wbsSheet}}", "firstRow": "{{vars.wbsFirstRow}}",
                "columns": { "job": "A", "side": "B", "task": "G", "owner": "P", "start": "AF", "end": "AG", "done": "AJ" },
                "dateFields": ["start", "end", "done"],
                "where": [ { "field": "side", "op": "equals", "value": "{{vars.side}}" },
                           { "field": "task", "op": "equals", "value": "{{vars.task}}" } ],
                "pluck": "job" } },
    { "id": "wbsClose", "use": "excel.close", "with": { "workbook": "wbs" } },
    { "id": "derive", "use": "verify.derive_fields",
      "label": "W 名 = J 名の 5 文字目 J -> W(plan と同じ)",
      "with": { "records": "{{steps.rows.out.records}}",
                "set": [ { "to": "Excel_NAME", "from": "job", "pattern": "^(.{4})J", "replace": "${1}W" },
                         { "to": "JOB", "from": "job" } ] } },
    { "id": "pick", "use": "verify.filter_records",
      "label": "-Only の名前の行だけ",
      "with": { "records": "{{steps.derive.out.records}}",
                "where": [ { "field": "Excel_NAME", "op": "in", "value": "{{run.only}}" } ], "emptyOk": true, "pluck": "Excel_NAME" } },
    { "id": "found", "use": "verify.compare_sets",
      "with": { "left": "{{run.only}}", "right": "{{steps.pick.out.plucked}}", "leftLabel": "-Only", "rightLabel": "WBS 受信 / 修正後実施" } },
    { "id": "foundGate", "use": "human.gate",
      "label": "WBS に無い名前があれば聞く: Enter = 見つかった分だけ入れる / q = やめる(名前を直して再実行)",
      "with": { "code": "{{steps.found.out.code}}", "askWhen": ["unknown"],
                "reason": "{{steps.found.out.reason}}" } },
    { "id": "day", "use": "verify.derive_fields",
      "with": { "records": "{{steps.pick.out.records}}",
                "set": [ { "to": "GFIX_DATE", "value": "{{run.date}}" }, { "to": "WORKDAY", "value": "{{run.date}}" } ] } },
    { "id": "upsert", "use": "table.upsert",
      "label": "作業リストへ: WORKDAY = GFIX_DATE = 今日。日付が変わった行は track / logs / evidence / deliver を空に",
      "with": { "worklist": "wl", "rows": "{{steps.day.out.records}}",
                "fields": { "Excel_NAME": "Excel_NAME", "JOB": "JOB", "GFIX_DATE": "GFIX_DATE", "WORKDAY": "WORKDAY", "Owner": "owner" },
                "overwrite": ["GFIX_DATE", "WORKDAY"],
                "resetOnChange": { "watch": "GFIX_DATE", "clear": ["track", "logs", "evidence", "deliver"] } } }
  ],

  "teardown": [
    { "id": "quit", "use": "excel.quit_app", "with": { "app": "xl" } },
    { "id": "status", "use": "progress.status",
      "with": { "worklist": "wl", "field": "track",
                "next": ["ebi.ps1 run workflows\\gfixRecv.track.json -WorkDir {{run.workDir}}   (GIFT と GFIX のデータが違うのは POM ではありうる: GATE で o)"] } }
  ]
}
