{
  "schema": 1,
  "id": "kadou.evidence",
  "title": "JJODWDBx 稼働確認: ジョブごとの証跡ブック(GFIX受信結果 + GFIXデータ の 2 シートだけ)を kadou.collect の結果から作る",
  "version": "0.1.0",
  "profile": "jod-kadou",

  "vars": { "capture": "capture/kadou" },

  "source": {
    "table": "wl",
    "select": { "field": "evidence", "pendingWhen": "!= ok" },
    "groupBy": "JOB",
    "orderBy": "SLOT"
  },

  "onError": { "policy": "ask",
               "byFailure": { "not_met": { "policy": "skip" },
                              "write_failed": { "policy": "retry" }, "save_failed": { "policy": "retry" } } },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "as": "wl" } },
    { "id": "app", "use": "excel.ensure_app",
      "with": { "visible": true, "as": "xl" } }
  ],

  "each": [
    { "id": "rec", "use": "file.read_json",
      "label": "kadou.collect の結果(無ければこの転送は飛ばす)",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/collect.json" } },
    { "id": "recHere", "use": "flow.require",
      "when": "steps.rec.out.exists == false",
      "with": { "value": "missing", "equals": "present",
                "message": "collect.json is not there: run kadou.collect for {{item.key}} first" } },
    { "id": "runHere", "use": "flow.require",
      "when": "steps.rec.out.data.file empty",
      "with": { "value": "none", "equals": "a run",
                "message": "kadou.collect found no ok run of {{item.key}} today (collect = ng): nothing to put in the book -- write it up by hand" } },

    { "id": "bookList", "use": "file.list", "once": "group",
      "with": { "dir": "{{profile.layout.evidenceDir}}", "glob": "{{profile.layout.bookPrefix}}{{item.JOB}}{{profile.layout.bookSuffix}}", "mustExist": false } },
    { "id": "bookNew", "use": "file.move", "once": "group",
      "label": "このジョブのブックがまだ無ければ空のひな形をコピー(あれば上書きしない: 同じ場所に書き直す)",
      "when": "steps.bookList.out.total == 0",
      "with": { "from": "{{run.toolDir}}/{{profile.layout.template}}", "copy": true,
                "to": "{{profile.layout.evidenceDir}}/{{profile.layout.bookPrefix}}{{item.JOB}}{{profile.layout.bookSuffix}}" } },
    { "id": "bookFree", "use": "file.wait_unlocked", "once": "group",
      "with": { "path": "{{profile.layout.evidenceDir}}/{{profile.layout.bookPrefix}}{{item.JOB}}{{profile.layout.bookSuffix}}", "everySec": 10, "timeoutMin": 10 } },
    { "id": "open", "use": "excel.open", "once": "group",
      "with": { "app": "xl", "path": "{{profile.layout.evidenceDir}}/{{profile.layout.bookPrefix}}{{item.JOB}}{{profile.layout.bookSuffix}}", "as": "wb" } },
    { "id": "jkHead", "use": "excel.write_cell", "once": "group",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.recv}}", "cell": "B{{profile.layout.labels.jenkinsRow}}",
                "value": "{{profile.layout.labels.jenkins}}", "fontName": "{{profile.layout.font.name}}", "fontSize": "{{profile.layout.font.size}}" } },

    { "id": "label", "use": "excel.write_cell",
      "label": "相関ID(その下がバッチ処理状況一覧の画像)",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.recv}}", "cell": "B{{item.LABEL_ROW}}", "value": "{{item.CORREL}}",
                "fontName": "{{profile.layout.font.name}}", "fontSize": "{{profile.layout.font.size}}" } },
    { "id": "bsPic", "use": "excel.place_picture",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.recv}}", "path": "{{steps.rec.out.data.batchPng}}",
                "cell": "B{{item.PIC_ROW}}", "replace": "atCell", "name": "kadou_batch_{{item.CORREL}}" } },
    { "id": "jobLog", "use": "excel.write_lines",
      "label": "▼GFIXログ + 証跡に選んだラウンドのジョブログ",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.recv}}", "row": "{{item.LOG_ROW}}",
                "label": "{{profile.layout.labels.jobLog}}", "labelBold": true, "paths": ["{{steps.rec.out.data.jobLog}}"],
                "fontName": "{{profile.layout.font.name}}", "fontSize": "{{profile.layout.font.size}}" } },
    { "id": "jobMark", "use": "excel.highlight",
      "label": "Command の行を黄色(参考資料と同じ)",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.recv}}", "fromRow": "{{steps.jobLog.out.firstRow}}", "toRow": "{{steps.jobLog.out.lastRow}}",
                "patterns": "{{profile.layout.highlight.jobLog}}", "unitsPerColumn": "{{profile.layout.highlight.unitsPerColumn}}", "expect": 1 } },
    { "id": "jkLabel", "use": "excel.write_cell",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.recv}}", "cell": "B{{item.JK_ROW}}", "value": "{{item.CORREL}}",
                "fontName": "{{profile.layout.font.name}}", "fontSize": "{{profile.layout.font.size}}" } },
    { "id": "jkPic", "use": "excel.place_picture",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.recv}}", "path": "{{steps.rec.out.data.jenkinsPng}}",
                "cell": "B{{item.JKPIC_ROW}}", "replace": "atCell", "name": "kadou_jenkins_{{item.CORREL}}" } },
    { "id": "data", "use": "excel.write_lines",
      "label": "GFIXデータ: 相関ID + 受信ファイルの中身(Jenkins から取ったもの、GIFT との比較はしない)",
      "with": { "workbook": "wb", "sheet": "{{profile.layout.sheets.data}}", "row": "{{item.DATA_ROW}}",
                "label": "{{item.CORREL}}", "paths": "{{steps.rec.out.data.dataFiles}}",
                "fontName": "{{profile.layout.font.name}}", "fontSize": "{{profile.layout.font.size}}" } },
    { "id": "fits", "use": "verify.assert",
      "with": { "record": { "lines": "{{steps.data.out.written}}", "log": "{{steps.jobLog.out.written}}" },
                "rules": { "default": "ok", "rules": [
                  { "field": "lines", "op": "lte", "value": "{{profile.layout.dataMaxLines}}", "else": "unknown",
                    "message": "GFIXデータ: {{steps.data.out.written}} lines from row {{item.DATA_ROW}} run into the next transfer's place (60 rows each) -- move them by hand" },
                  { "field": "log", "op": "lte", "value": "50", "else": "unknown",
                    "message": "the job log has {{steps.jobLog.out.written}} lines: it runs into the next transfer's place (95 rows each) -- move it by hand" } ] } } },
    { "id": "fitGate", "use": "human.gate",
      "with": { "code": "{{steps.fits.out.code}}", "askWhen": ["unknown"], "key": "{{item.key}}",
                "reason": "{{steps.fits.out.reason}}", "front": ["EXCEL"] } },
    { "id": "record", "use": "file.write_json",
      "with": { "path": "{{vars.capture}}/{{item.keySafe}}/evidence.json",
                "data": { "key": "{{item.key}}", "job": "{{item.JOB}}", "book": "{{steps.open.out.path}}", "file": "{{steps.rec.out.data.file}}",
                          "logRows": ["{{steps.jobLog.out.firstRow}}", "{{steps.jobLog.out.lastRow}}"], "dataLines": "{{steps.data.out.written}}",
                          "fits": "{{steps.fits.out.code}}" } } },
    { "id": "checkpoint", "use": "flow.checkpoint",
      "when": "steps.fitGate.out.action != skip",
      "with": { "worklist": "wl", "field": "evidence", "value": "ok" } },

    { "id": "look", "use": "human.gate", "once": "groupEnd",
      "label": "このジョブのブックを Excel で見る。Enter = 保存して閉じる",
      "with": { "code": "unknown", "askWhen": ["unknown"], "key": "{{item.JOB}}",
                "reason": "{{item.JOB}}: the book is filled (3 transfers). Look at it in Excel, then Enter: it is saved and closed. B3 (the attachment's 3 rows) is yours to paste",
                "checklist": "{{profile.layout.checklist}}", "evidence": "{{steps.open.out.path}}", "front": ["EXCEL"] } },
    { "id": "tidy", "use": "excel.tidy", "once": "groupEnd",
      "with": { "workbook": "wb", "cell": "{{profile.layout.homeCell}}", "dismissDialogs": "{{profile.layout.saveDialogs}}",
                "fontSheets": ["{{profile.layout.sheets.recv}}"], "fontName": "{{profile.layout.font.name}}", "fontSize": "{{profile.layout.font.size}}" } },
    { "id": "close", "use": "excel.close", "once": "groupEnd",
      "with": { "workbook": "wb", "save": false } }
  ],

  "teardown": [
    { "id": "quit", "use": "excel.quit_app", "with": { "app": "xl" } },
    { "id": "status", "use": "progress.status",
      "with": { "worklist": "wl", "field": "evidence",
                "next": ["ブックは {{run.workDir}}\\{{profile.layout.evidenceDir}} に。B3 の図を貼って、どのブックに入れるかは awe が決める"] } }
  ]
}
