{
  "schema": 1,
  "id": "gfixRecv.wbscheck",
  "title": "GFIX受信: 自己チェック(WBS の実績 AK と作業リストが合っているか。見るだけ、どちらも書かない)",
  "version": "0.1.0",
  "_doc": "10/20: the menu's k -> w runs this with -Profile gfix-recv (no profile here, so it is not a day phase). Reads the operator's own WBS rows (B = 受信, G = 修正後実施, P = owner rule) and writes capture/selfcheck/wbs.json: doneOnWbs = AK filled but deliver not ok in gfixrecv.csv; blankOnWbs = deliver ok in gfixrecv.csv but AK blank. The menu shows it.",
  "vars": { "wbsSheet": "WBS", "wbsFirstRow": 7, "side": "受信", "task": "修正後実施" },
  "setup": [
    { "id": "load", "use": "table.load", "with": { "path": "{{profile.worklist.file}}", "as": "wl" } },
    { "id": "app", "use": "excel.ensure_app", "with": { "visible": false, "as": "xl" } },
    { "id": "ownerPat", "use": "verify.owner_pattern", "with": { "owner": "{{profile.operator.owner}}" } },
    { "id": "wbs", "use": "excel.open", "with": { "app": "xl", "path": "{{profile.paths.wbs}}", "readOnly": true, "as": "wbs" } },
    { "id": "rows", "use": "excel.read_rows",
      "label": "WBS: 自分の 受信 / 修正後実施 の行(AK = 実績終了)",
      "with": { "workbook": "wbs", "sheet": "{{vars.wbsSheet}}", "firstRow": "{{vars.wbsFirstRow}}",
                "columns": { "job": "A", "side": "B", "task": "G", "owner": "P", "end": "AK" }, "dateFields": ["end"],
                "where": [ { "field": "side", "op": "equals", "value": "{{vars.side}}" },
                           { "field": "task", "op": "equals", "value": "{{vars.task}}" },
                           { "field": "owner", "op": "matches", "value": "{{steps.ownerPat.out.pattern}}" } ] } },
    { "id": "wbsClose", "use": "excel.close", "with": { "workbook": "wbs" } },
    { "id": "derive", "use": "verify.derive_fields",
      "with": { "records": "{{steps.rows.out.records}}", "set": [ { "to": "Excel_NAME", "from": "job", "pattern": "^(.{4})J", "replace": "${1}W" } ] } },
    { "id": "filled", "use": "verify.filter_records",
      "with": { "records": "{{steps.derive.out.records}}", "where": [ { "field": "end", "op": "present" } ], "pluck": "Excel_NAME", "emptyOk": true } },
    { "id": "blank", "use": "verify.filter_records",
      "with": { "records": "{{steps.derive.out.records}}", "where": [ { "field": "end", "op": "empty" } ], "pluck": "Excel_NAME", "emptyOk": true } },
    { "id": "pending", "use": "table.select", "with": { "worklist": "wl", "field": "deliver", "pendingWhen": "!= ok" } },
    { "id": "every", "use": "table.select", "with": { "worklist": "wl", "pendingWhen": "always" } },
    { "id": "c1", "use": "verify.compare_sets",
      "label": "AK あり x 作業リストで deliver 未 = WBS では済み、ここでは未",
      "with": { "left": "{{steps.filled.out.plucked}}", "right": "{{steps.pending.out.keyList}}", "leftLabel": "WBS AK filled", "rightLabel": "pending here" } },
    { "id": "c2", "use": "verify.compare_sets",
      "with": { "left": "{{steps.blank.out.plucked}}", "right": "{{steps.every.out.keyList}}", "leftLabel": "WBS AK blank", "rightLabel": "worklist" } },
    { "id": "c3", "use": "verify.compare_sets",
      "label": "AK 空 x 作業リストにある x deliver 済み = ここでは済み、WBS は空",
      "with": { "left": "{{steps.c2.out.both}}", "right": "{{steps.pending.out.keyList}}", "leftLabel": "WBS AK blank", "rightLabel": "pending here" } },
    { "id": "report", "use": "file.write_json",
      "with": { "path": "capture/selfcheck/wbs.json",
                "data": { "at": "{{run.date}}", "doneOnWbs": "{{steps.c1.out.both}}", "blankOnWbs": "{{steps.c3.out.onlyLeft}}" } } }
  ],
  "teardown": [
    { "id": "quit", "use": "excel.quit_app", "with": { "app": "xl" } }
  ]
}
