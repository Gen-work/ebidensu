{
  "schema": 1,
  "id": "gfixRecv.deliver",
  "title": "GFIX受信: レビュー依頼(チェックシートに全部書く -> 確認 -> 下書きを全部 -> 全部送ったら ok -> WBS の実績 AJ/AK)",
  "version": "0.4.1",
  "profile": "gfix-recv",

  "vars": {
    "_wbs_doc": "10/20: after every draft is sent, the WBS row of each job (A = JOB, B = side, G = task) gets AJ (実績 開始) = the day its GFIX job ran (GFIX_DATE) and AK (実績 終了) = today -- blank cells only, shown before saving. s at the open / the panel leaves the WBS as it was (type it by hand)",
    "_wbs_doc2": "10/20 second day: both task rows (修正後実施 and 結果まとめ) of the operator's own WBS rows (P = owner / owner<-other, the plan's owner rule) get AJ = AK = the day asked (Enter = today; 10/21 works) and AQ (実績工数) = the hours asked (Enter = 0.1). Blank cells only.",
    "wbsSheet": "WBS", "wbsFirstRow": 7, "side": "受信", "tasks": ["修正後実施", "結果まとめ"], "wbsHours": "0.1",
    "_wbs_doc3": "10/22 (the leader: the WBS lines owned by the operator looked broken): the cells written are filled light violet for the check; Enter = close WITHOUT saving, open again, write the same values with no fill, save -- the fill never reaches the shared file; s / q / anything else = close without saving, the WBS stays as it was. Formula cells are never written.",
    "wbsHighlight": "#E6D6FF,#D2B9F5,#F3EBFF"
  },

  "source": {
    "table": "wl",
    "select": { "field": "deliver", "pendingWhen": "!= ok" },
    "groupBy": "Excel_NAME",
    "orderBy": "GFIX_TIME"
  },

  "onError": { "policy": "ask", "byFailure": { "not_met": { "policy": "skip" },
                                               "write_failed": { "policy": "retry", "times": 4, "backoffMs": 1500 },
                                               "save_failed": { "policy": "retry", "times": 3, "backoffMs": 2000 } } },

  "setup": [
    { "id": "load", "use": "table.load",
      "with": { "path": "{{profile.worklist.file}}", "as": "wl" } },
    { "id": "app", "use": "excel.ensure_app", "with": { "visible": true, "as": "xl" } },
    { "id": "sheetFree", "use": "file.wait_unlocked",
      "label": "レビューチェックシートが空くまで待つ(誰が開いているか表示、q / Esc で止める)",
      "with": { "path": "{{profile.paths.reviewSheet}}", "everySec": 30, "timeoutMin": 30 } },
    { "id": "sheet", "use": "excel.open",
      "label": "レビューチェックシート(共有。誰かが開いていたら r で待つ)",
      "with": { "app": "xl", "path": "{{profile.paths.reviewSheet}}", "as": "cs" } }
  ],

  "each": [
    { "id": "evOk", "use": "flow.require",
      "label": "evidence が ok の行だけ(まだなら黙って飛ばす)",
      "with": { "value": "{{item.evidence}}", "equals": "ok",
                "message": "the evidence of this job is not ok yet: run gfixRecv.evidence first" } },
    { "id": "book", "use": "file.find",
      "label": "証跡ブックのファイル名(チェックシートの レビュー対象 / メール本文)",
      "with": { "dir": "{{profile.paths.bix}}", "glob": "{{profile.layout.evidence.glob}}", "expect": "one" } },
    { "id": "listed", "use": "excel.append_row",
      "label": "もうチェックシートに載っているか(見るだけ)。載っていれば手で依頼済み: 行もメールもなしで ok",
      "with": { "workbook": "cs", "sheet": "{{profile.layout.checkSheet.sheet}}", "checkOnly": true,
                "keyColumn": "F", "lastBy": "B", "firstRow": "{{profile.layout.checkSheet.firstRow}}",
                "cells": { "F": "{{steps.book.out.name}}" } } },
    { "id": "row", "use": "excel.append_row",
      "label": "Check Sheet_J4 に 1 行書く(まだ保存しない: 全部書いてから after でまとめて確認)",
      "when": "steps.listed.out.existing == false",
      "with": { "workbook": "cs", "sheet": "{{profile.layout.checkSheet.sheet}}", "save": false,
                "keyColumn": "F", "lastBy": "B", "firstRow": "{{profile.layout.checkSheet.firstRow}}", "dateColumns": ["B"],
                "cells": { "B": "{{run.date}}", "C": "{{profile.layout.checkSheet.language}}", "E": "{{profile.layout.checkSheet.phase}}",
                           "F": "{{steps.book.out.name}}", "G": "{{profile.operator.owner}}", "H": "{{profile.operator.reviewer}}" } } },
    { "id": "listedOk", "use": "flow.checkpoint",
      "label": "手で載っていた行は依頼済み: ok",
      "when": "steps.listed.out.existing == true",
      "with": { "worklist": "wl", "field": "deliver", "value": "ok" } }
  ],

  "after": [
    { "id": "pick", "use": "table.select",
      "label": "このランで行を書いたジョブ(手で載っていた分は each で ok 済み)",
      "with": { "worklist": "wl", "field": "deliver", "pendingWhen": "!= ok", "only": "{{run.doneKeys}}" } },
    { "id": "rowsOk", "use": "human.gate",
      "label": "書いた行を Excel で見る(まだ保存していない)。Enter = 全部正しい -> 保存してメール下書きへ",
      "when": "steps.pick.out.selected != 0",
      "with": { "code": "unknown", "askWhen": ["unknown"], "key": "Check Sheet_J4",
                "reason": "{{steps.pick.out.selected}} row(s) written to the check sheet, not saved yet",
                "checklist": "{{profile.layout.checkSheet.checklistRows}}",
                "evidence": "{{steps.pick.out.keyList}}", "front": ["EXCEL"] } },
    { "id": "save", "use": "excel.close",
      "label": "確認できたらチェックシートを保存して閉じる",
      "when": "steps.rowsOk.out.action == ok",
      "with": { "workbook": "cs", "save": true, "dismissDialogs": "{{profile.layout.evidence.saveDialogs}}" } },
    { "id": "mails", "use": "human.draft_mail",
      "label": "レビュー依頼メールの下書き(1 ジョブ 1 通、全部開く)。送信は人",
      "when": "steps.rowsOk.out.action == ok",
      "with": { "template": "{{profile.paths.mailTemplate}}", "valueList": "{{steps.pick.out.keyList}}" } },
    { "id": "sent", "use": "human.gate",
      "label": "下書きを全部前に出す。全部送ったら Enter -> deliver = ok",
      "when": "steps.rowsOk.out.action == ok",
      "with": { "code": "unknown", "askWhen": ["unknown"], "key": "review mails",
                "reason": "send every draft in Outlook",
                "checklist": "{{profile.layout.checkSheet.checklistSent}}",
                "evidence": "{{steps.mails.out.subjects}}", "front": "{{steps.mails.out.subjects}}" } },
    { "id": "done", "use": "table.set",
      "label": "全部送った: このランのジョブを deliver = ok",
      "when": "steps.sent.out.action == ok",
      "with": { "worklist": "wl", "keyList": "{{steps.pick.out.keyList}}", "field": "deliver", "value": "ok" } },
    { "id": "wbsOwner", "use": "verify.owner_pattern",
      "label": "WBS の担当 (P) = operator.owner / owner←○○ / ○○→owner の行だけ",
      "when": "steps.sent.out.action == ok",
      "with": { "owner": "{{profile.operator.owner}}" } },
    { "id": "wbsDay", "use": "human.input",
      "label": "WBS の実績日 AJ / AK(Enter = 今日、別の日なら 10/21)",
      "when": "steps.sent.out.action == ok",
      "with": { "question": "WBS actual date for AJ / AK (Enter = {{run.date}}, or type e.g. 10/21)", "default": "{{run.date}}" } },
    { "id": "wbsHours", "use": "human.input",
      "label": "WBS の実績工数 AQ(Enter = 0.1)",
      "when": "steps.sent.out.action == ok",
      "with": { "question": "WBS actual hours for AQ (Enter = {{vars.wbsHours}})", "default": "{{vars.wbsHours}}" } },
    { "id": "wbsFree", "use": "file.wait_unlocked",
      "label": "WBS が空くまで待つ(1 分ごと、誰が開いているか表示、q / Esc で止める)",
      "when": "steps.sent.out.action == ok",
      "with": { "path": "{{profile.paths.wbs}}", "everySec": 60, "timeoutMin": 30 } },
    { "id": "wbsOpen", "use": "excel.open",
      "label": "WBS を開く(共有。誰かが開いていたら r で待つ / s で手入力に回す)",
      "when": "steps.sent.out.action == ok",
      "with": { "app": "xl", "path": "{{profile.paths.wbs}}", "as": "wbs" } },
    { "id": "wbsMark", "use": "excel.mark_rows",
      "label": "WBS の実績: 修正後実施 / 結果まとめ の自分の行に AJ = AK = 実績日、AQ = 工数(空のセルだけ。まだ保存しない)",
      "when": "steps.wbsOpen.out.path exists",
      "with": { "workbook": "wbs", "sheet": "{{vars.wbsSheet}}", "firstRow": "{{vars.wbsFirstRow}}",
                "keyColumn": "A", "items": "{{steps.pick.out.rows}}", "keyField": "JOB",
                "where": { "B": "{{vars.side}}", "G": "{{vars.tasks}}" },
                "whereMatch": { "P": "{{steps.wbsOwner.out.pattern}}" },
                "setValues": { "AJ": "{{steps.wbsDay.out.value}}", "AK": "{{steps.wbsDay.out.value}}", "AQ": "{{steps.wbsHours.out.value}}" },
                "dateColumns": ["AJ", "AK"], "numberColumns": ["AQ"], "highlight": "{{vars.wbsHighlight}}" } },
    { "id": "wbsNone", "use": "human.gate",
      "label": "WBS に何も書けなかった(薄紫のセルなし): 赤 = ジョブごとに行を外した理由。AJ / AK / AQ は手で入力。Enter / s = 保存せずに閉じる",
      "when": "steps.wbsMark.out.writtenCount == 0",
      "with": { "code": "ng", "askWhen": ["ng"], "key": "WBS",
                "reason": "nothing was written to the WBS: no row of these jobs passed every check -- type AJ / AK / AQ by hand. Red: why each job's rows were passed over (A = JOB, B = {{vars.side}}, G = one of the tasks, P = the owner pattern). Below: cells already filled or holding a formula. Any answer closes the WBS without saving",
                "evidence": "{{steps.wbsMark.out.kept}}", "alert": "{{steps.wbsMark.out.missed}}", "front": ["EXCEL"] } },
    { "id": "wbsOk", "use": "human.gate",
      "label": "WBS に書いたセル(薄紫)を Excel で見る。Enter = 色なしで書き直して保存 / s・q = 何も変えずに閉じる",
      "when": "steps.wbsMark.out.writtenCount != 0",
      "with": { "code": "unknown", "askWhen": ["unknown"], "key": "WBS",
                "reason": "{{steps.wbsMark.out.writtenCount}} WBS row(s) written, the cells filled light violet ({{steps.wbsMark.out.highlight}}) for this check only. Enter: close WITHOUT saving, open again, write the same values with no fill, save. s / q: close without saving -- the WBS stays as it was",
                "evidence": "{{steps.wbsMark.out.written}}", "alert": "{{steps.wbsMark.out.notFound}}", "front": ["EXCEL"] } },
    { "id": "wbsDiscard", "use": "excel.close",
      "label": "確認用(薄紫)の WBS は保存せずに閉じる",
      "when": "steps.wbsOk.out.action == ok",
      "with": { "workbook": "wbs", "save": false } },
    { "id": "wbsFree2", "use": "file.wait_unlocked",
      "label": "WBS がまた空くまで待つ",
      "when": "steps.wbsOk.out.action == ok",
      "with": { "path": "{{profile.paths.wbs}}", "everySec": 30, "timeoutMin": 30 } },
    { "id": "wbsOpen2", "use": "excel.open",
      "label": "WBS をもう一度開く",
      "when": "steps.wbsOk.out.action == ok",
      "with": { "app": "xl", "path": "{{profile.paths.wbs}}", "as": "wbs2" } },
    { "id": "wbsWrite", "use": "excel.mark_rows",
      "label": "確認した同じ値を色なしで書く(空のセルだけ、式のセルは書かない)",
      "when": "steps.wbsOpen2.out.path exists",
      "with": { "workbook": "wbs2", "sheet": "{{vars.wbsSheet}}", "firstRow": "{{vars.wbsFirstRow}}",
                "keyColumn": "A", "items": "{{steps.pick.out.rows}}", "keyField": "JOB",
                "where": { "B": "{{vars.side}}", "G": "{{vars.tasks}}" },
                "whereMatch": { "P": "{{steps.wbsOwner.out.pattern}}" },
                "setValues": { "AJ": "{{steps.wbsDay.out.value}}", "AK": "{{steps.wbsDay.out.value}}", "AQ": "{{steps.wbsHours.out.value}}" },
                "dateColumns": ["AJ", "AK"], "numberColumns": ["AQ"] } },
    { "id": "wbsSave", "use": "excel.close",
      "label": "WBS を保存して閉じる",
      "when": "steps.wbsWrite.out.writtenCount exists",
      "with": { "workbook": "wbs2", "save": true, "dismissDialogs": "{{profile.layout.evidence.saveDialogs}}" } }
  ],

  "teardown": [
    { "id": "close", "use": "excel.close", "with": { "workbook": "cs", "save": false } },
    { "id": "wbsClose", "use": "excel.close", "with": { "workbook": "wbs", "save": false } },
    { "id": "wbs2Close", "use": "excel.close", "with": { "workbook": "wbs2", "save": false } },
    { "id": "quit", "use": "excel.quit_app", "with": { "app": "xl" } },
    { "id": "status", "use": "progress.status", "with": { "worklist": "wl", "field": "deliver", "next": ["今日の分は以上。Outlook の送信済みと gfixrecv.csv の deliver 列を確認"] } }
  ]
}
