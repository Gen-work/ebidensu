    "browser.assert_page": {
      "effects": "pure",
      "example": {
        "use": "browser.assert_page",
        "with": {
          "fingerprint": "{{page.fingerprint}}",
          "text": "{{steps.wait.out.text}}"
        }
      },
      "failures": [
        {
          "id": "page_loading",
          "transient": true
        },
        {
          "id": "page_empty",
          "transient": false
        },
        {
          "id": "page_expired",
          "transient": false
        },
        {
          "id": "page_unknown",
          "transient": false
        }
      ],
      "file": "modules/browser/browser.assert_page.ps1",
      "group": "browser",
      "id": "browser.assert_page",
      "idempotent": true,
      "inputs": {
        "fingerprint": {
          "desc": "{ ok: [...all must appear], loading: [...], empty: [...], expired: [...] } (any one appears)",
          "required": true,
          "type": "map"
        },
        "text": {
          "desc": "the page text (browser.wait_for / read_text output)",
          "required": true,
          "type": "string"
        }
      },
      "needs": [],
      "notes": "Order of judgment: blank text is loading; then expired, then empty, then loading (any listed string), then ok (ALL listed strings); anything else is unknown. expired / empty / unknown are not transient: retrying the same page changes nothing, a person must look.",
      "outputs": {
        "kind": {
          "desc": "ok | loading | empty | expired | unknown",
          "type": "string"
        },
        "matched": {
          "desc": "the fingerprint strings that were found",
          "type": "list"
        }
      },
      "provides": [],
      "releases": [],
      "summary": "Classify page text by fingerprint: ok, loading, empty, expired, unknown",
      "tier": "core"
    },
