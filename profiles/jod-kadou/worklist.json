{
  "_doc": "kadou.csv: one row per transfer (相関ID), nine rows, written by the first kadou.collect run from targets.json (table.upsert: existing rows keep their progress). Columns B / C_JK / C_BS are the summary table (9 rows x B / C), collect / evidence the phase verdicts.",
  "file": "kadou.csv",
  "encoding": "utf8-bom",
  "key": {
    "columns": [
      "CORREL"
    ],
    "confirmedRules": [
      {
        "kind": "case-insensitive"
      }
    ],
    "ambiguityPolicy": "listAndAsk"
  },
  "dashboard": {
    "columns": [
      "JOB",
      "SYS",
      "FILE",
      "B",
      "C_JK",
      "C_BS"
    ]
  },
  "columns": [
    {
      "name": "CORREL",
      "role": "key"
    },
    {
      "name": "JOB",
      "role": "text",
      "default": ""
    },
    {
      "name": "SLOT",
      "role": "text",
      "default": ""
    },
    {
      "name": "SYS",
      "role": "text",
      "default": ""
    },
    {
      "name": "IFNO",
      "role": "text",
      "default": ""
    },
    {
      "name": "PROJECT",
      "role": "text",
      "default": ""
    },
    {
      "name": "RECVDIR",
      "role": "text",
      "default": ""
    },
    {
      "name": "SHELL",
      "role": "text",
      "default": ""
    },
    {
      "name": "SS",
      "role": "text",
      "default": ""
    },
    {
      "name": "BATCH",
      "role": "text",
      "default": ""
    },
    {
      "name": "EXPECT",
      "role": "text",
      "default": ""
    },
    {
      "name": "LABEL_ROW",
      "role": "text",
      "default": ""
    },
    {
      "name": "PIC_ROW",
      "role": "text",
      "default": ""
    },
    {
      "name": "LOG_ROW",
      "role": "text",
      "default": ""
    },
    {
      "name": "JK_ROW",
      "role": "text",
      "default": ""
    },
    {
      "name": "JKPIC_ROW",
      "role": "text",
      "default": ""
    },
    {
      "name": "DATA_ROW",
      "role": "text",
      "default": ""
    },
    {
      "name": "RUNS",
      "role": "text",
      "default": "",
      "_doc": "today: \"<ok>/<runs> ok\" of GoAnywhere runs (B, every round)"
    },
    {
      "name": "FILE",
      "role": "text",
      "default": "",
      "_doc": "the transfer file chosen for the evidence (the earliest round whose B and C are both there)"
    },
    {
      "name": "B",
      "role": "text",
      "default": "",
      "_doc": "GFIX side (GoAnywhere job log): ok / ng / unknown (= 未取得)"
    },
    {
      "name": "C_JK",
      "role": "text",
      "default": "",
      "_doc": "OPEN side, the file in the Jenkins receive folder: ok / unknown"
    },
    {
      "name": "C_BS",
      "role": "text",
      "default": "",
      "_doc": "OPEN side, バッチ処理状況一覧: 正常終了 + batch id + 相関ID on the page: ok / ng / unknown"
    },
    {
      "name": "collect",
      "role": "verdict",
      "default": "",
      "doneFile": "capture/kadou/{{item.keySafe}}/collect.json",
      "values": {
        "ok": "ok",
        "ng": "ng",
        "unknown": "",
        "pending": ""
      }
    },
    {
      "name": "evidence",
      "role": "verdict",
      "default": "",
      "doneFile": "capture/kadou/{{item.keySafe}}/evidence.json",
      "values": {
        "ok": "ok",
        "ng": "ng",
        "unknown": "",
        "pending": ""
      }
    },
    {
      "name": "note",
      "role": "text",
      "default": ""
    }
  ],
