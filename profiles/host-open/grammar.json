{
  "fileList": {
    "ignore": [],
    "pattern": "^(?<name>\\S+)\\s+(?<date>\\d{4}/\\d{2}/\\d{2})\\s+(?<time>\\d{1,2}:\\d{2}:\\d{2})\\s+(?<size>.+?)\\s+参照$",
    "parser": "regex"
  },
  "jobList": {
    "ignore": [],
    "rowWhen": {
      "field": "jobNo",
      "matches": "^\\d{6,}$"
    },
    "fields": [
      "jobNo",
      "projectName",
      "folder",
      "status",
      "user",
      "startTime",
      "endTime",
      "seconds",
      "method"
    ],
    "parser": "delimited",
    "delimiter": "\t"
  },
  "hmResult": {
    "fields": [
      "startTime",
      "endTime",
      "duration",
      "batchId",
      "ss",
      "status",
      "dataCreated",
      "recordCount",
      "result",
      "key"
    ],
    "ignore": [
      "^開始日時\\t",
      "^バッチ処理状況一覧",
      "^test$"
    ],
    "lastNonEmpty": "key",
    "parser": "delimited",
    "delimiter": "\t",
    "rowWhen": {
      "field": "startTime",
      "matches": "^\\d{4}/\\d{2}/\\d{2} \\d{1,2}:\\d{2}:\\d{2}$"
    }
  },
  "transferStatus": {
    "ignore": [
      "^Transfer status inquiry results",
      "^Number of records",
      "^No\\t",
      "^Msgid\\t",
      "^[A-Z]\\d{7}[A-Z]\\d{10}\\t"
    ],
    "rowWhen": {
      "field": "no",
      "matches": "^\\d+$"
    },
    "fields": [
      "no",
      "sendNode",
      "recvNode",
      "key",
      "sendTime",
      "tmode",
      "recvTime",
      "rtncd",
      "rsncd"
    ],
    "parser": "delimited",
    "delimiter": "\t"
  }
}
